config_version=5
[application]
config/name="Minik Maze"
boot_splash/image="res://art/home-portrait.png"
boot_splash/fullsize=true
boot_splash/bg_color=Color(0.72, 0.89, 1, 1)
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
[display]
window/size/viewport_width=720
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6
[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.53, 0.78, 0.94, 1)
anti_aliasing/quality/msaa_3d=1
[physics]
common/physics_ticks_per_second=60

[autoload]

MazeServicesIOS="*res://ios/maze_services_ios.gd"

[internationalization]

locale/translations=PackedStringArray("res://ios/app-name.he.po")
