var translations:Dictionary=JSON.parse_string(FileAccess.get_file_as_string("res://ui-languages.json"))
func t(key:String,arg:String="")->String:
	return str(translations.get(language,{}).get(key,HE.get(key,key) if language=="he" else key)).replace("{0}",arg)
func rtl()->bool:return language in ["he","ar"]
