                    "Choose 2 pictures that start with the same letter": {"extractionState":"manual","comment":"Android reference: letter_pairs_instruction_placeholder","localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose 2 pictures that start with the same letter"}},"am":{"stringUnit":{"state":"translated","value":"በአንድ ፊደል የሚጀምሩ 2 ምስሎችን ይምረጡ"}},"ar":{"stringUnit":{"state":"translated","value":"اختر صورتين تبدأان بالحرف نفسه"}},"de":{"stringUnit":{"state":"translated","value":"Wähle 2 Bilder aus, die mit demselben Buchstaben beginnen"}},"es":{"stringUnit":{"state":"translated","value":"Elige 2 imágenes que empiecen por la misma letra"}},"fr":{"stringUnit":{"state":"translated","value":"Choisis 2 images qui commencent par la même lettre"}},"nl":{"stringUnit":{"state":"translated","value":"Kies 2 afbeeldingen die met dezelfde letter beginnen"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha 2 imagens que começam com a mesma letra"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Escolhe 2 imagens que comecem pela mesma letra"}},"ru":{"stringUnit":{"state":"translated","value":"Выбери 2 картинки, которые начинаются с одной и той же буквы"}}}},
                    "Tap the letters in the right order to form the word": {"extractionState":"manual","comment":"Android reference: click_letters_screen_explian","localizations":{"en":{"stringUnit":{"state":"translated","value":"Tap the letters in the right order to form the word"}},"am":{"stringUnit":{"state":"translated","value":"ቃሉን ለመፍጠር ፊደላቱን በትክክለኛ ቅደም ተከተል ይንኩ"}},"ar":{"stringUnit":{"state":"translated","value":"اضغط على الحروف بالترتيب الصحيح لتكوين الكلمة"}},"de":{"stringUnit":{"state":"translated","value":"Tippt die Buchstaben in der richtigen Reihenfolge, um das Wort zu bilden"}},"es":{"stringUnit":{"state":"translated","value":"Toca las letras en el orden correcto para formar la palabra"}},"fr":{"stringUnit":{"state":"translated","value":"Touchez les lettres dans le bon ordre pour former le mot"}},"nl":{"stringUnit":{"state":"translated","value":"Tik de letters in de juiste volgorde om het woord te vormen"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Toque nas letras na ordem correta para formar a palavra"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Toca nas letras pela ordem certa para formar a palavra"}},"ru":{"stringUnit":{"state":"translated","value":"Нажимайте буквы в правильном порядке, чтобы составить слово"}}}},
                    "Drag and drop the letters in the right order toward the goal": {"extractionState":"manual","comment":"Android reference: letters_soccer_screen_explain","localizations":{"en":{"stringUnit":{"state":"translated","value":"Drag and drop the letters in the right order toward the goal"}},"am":{"stringUnit":{"state":"translated","value":"ፊደላቱን በትክክለኛ ቅደም ተከተል ወደ ግብ በመጎተት እና በመልቀቅ ያስገቡ"}},"ar":{"stringUnit":{"state":"translated","value":"اسحب الحروف بالترتيب الصحيح نحو المرمى"}},"de":{"stringUnit":{"state":"translated","value":"Zieht die Buchstaben in der richtigen Reihenfolge zum Tor"}},"es":{"stringUnit":{"state":"translated","value":"Arrastra las letras en el orden correcto hacia la portería"}},"fr":{"stringUnit":{"state":"translated","value":"Faites glisser les lettres dans le bon ordre vers le but"}},"nl":{"stringUnit":{"state":"translated","value":"Sleep de letters in de juiste volgorde naar het doel"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Arraste e solte as letras na ordem correta em direção ao gol"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Arrasta e larga as letras na ordem certa em direção à baliza"}},"ru":{"stringUnit":{"state":"translated","value":"Перетаскивайте буквы в правильном порядке к воротам"}}}},
                    "Drag the letters in the correct order": {"extractionState":"manual","comment":"Android reference: drag_the_letters_according_to_the_word_to_build_tower","localizations":{"en":{"stringUnit":{"state":"translated","value":"Drag the letters in the correct order"}},"am":{"stringUnit":{"state":"translated","value":"ፊደላቱን ትክክለኛ ቅደም ተከተል በማንቀሳቀስ ይዘርጉ"}},"ar":{"stringUnit":{"state":"translated","value":"اسحب الحروف بالترتيب الصحيح لبناء البرج"}},"de":{"stringUnit":{"state":"translated","value":"Zieht die Buchstaben in der richtigen Reihenfolge"}},"es":{"stringUnit":{"state":"translated","value":"Arrastra las letras en el orden correcto"}},"fr":{"stringUnit":{"state":"translated","value":"Faites glisser les lettres dans le bon ordre"}},"nl":{"stringUnit":{"state":"translated","value":"Sleep de letters in de juiste volgorde"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Arraste as letras na ordem correta"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Arrasta as letras pela ordem correta"}},"ru":{"stringUnit":{"state":"translated","value":"Перетащите буквы в правильном порядке"}}}},
                    "Tap the cards to flip them": {"extractionState":"manual","comment":"Android reference: memory_pictures_screen_explain","localizations":{"en":{"stringUnit":{"state":"translated","value":"Tap the cards to flip them"}},"am":{"stringUnit":{"state":"translated","value":"ካርዶቹን ለመገልበጥ ይንኩ"}},"ar":{"stringUnit":{"state":"translated","value":"اضغط على البطاقات لقلبها"}},"de":{"stringUnit":{"state":"translated","value":"Tippt auf die Karten, um sie umzudrehen"}},"es":{"stringUnit":{"state":"translated","value":"Toca las cartas para voltearlas"}},"fr":{"stringUnit":{"state":"translated","value":"Touchez les cartes pour les retourner"}},"nl":{"stringUnit":{"state":"translated","value":"Tik op de kaarten om ze om te draaien"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Toque nas cartas para virá-las"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Toca nas cartas para as virar"}},"ru":{"stringUnit":{"state":"translated","value":"Нажимайте на карточки, чтобы перевернуть их"}}}},
                    "Done": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"translated","value":"ጨርስ"}},"ar":{"stringUnit":{"state":"translated","value":"تم"}},"de":{"stringUnit":{"state":"translated","value":"Fertig"}},"en":{"stringUnit":{"state":"translated","value":"Done"}},"es":{"stringUnit":{"state":"translated","value":"Listo"}},"fr":{"stringUnit":{"state":"translated","value":"Terminé"}},"nl":{"stringUnit":{"state":"translated","value":"Klaar"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Concluir"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Concluído"}},"ru":{"stringUnit":{"state":"translated","value":"Готово"}}}},
                    "The records could not be loaded.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"translated","value":"ሪከርዶቹን መጫን አልተቻለም።"}},"ar":{"stringUnit":{"state":"translated","value":"تعذر تحميل جدول الأرقام القياسية."}},"de":{"stringUnit":{"state":"translated","value":"Die Rekordtabelle konnte nicht geladen werden."}},"en":{"stringUnit":{"state":"translated","value":"The records could not be loaded."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo cargar la tabla de récords."}},"fr":{"stringUnit":{"state":"translated","value":"Le classement n\\’a pas pu être chargé."}},"nl":{"stringUnit":{"state":"translated","value":"De ranglijst kon niet worden geladen."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível carregar o ranking."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Não foi possível carregar a classificação."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось загрузить таблицу рекордов."}}}},
                    "Top 20 records": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"translated","value":"ምርጥ 20 ሪከርዶች"}},"ar":{"stringUnit":{"state":"translated","value":"أفضل 20 رقمًا قياسيًا"}},"de":{"stringUnit":{"state":"translated","value":"Die 20 besten Rekorde"}},"en":{"stringUnit":{"state":"translated","value":"Top 20 records"}},"es":{"stringUnit":{"state":"translated","value":"Los 20 mejores récords"}},"fr":{"stringUnit":{"state":"translated","value":"Les 20 meilleurs records"}},"nl":{"stringUnit":{"state":"translated","value":"Top 20-records"}},"pt-BR":{"stringUnit":{"state":"translated","value":"20 melhores recordes"}},"pt-PT":{"stringUnit":{"state":"translated","value":"20 melhores recordes"}},"ru":{"stringUnit":{"state":"translated","value":"Топ-20 рекордов"}}}},
                    "Tap letters in the correct order to kick toward the goal.\nA goal with the right letter earns you a point.\nMissing or being saved with a wrong letter gives the keeper a point.\nThe round continues until the word is complete.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ፊደላቱን በትክክለኛ ቅደም ተከተል ወደ ግብ በመንካት ነጥብ ያግኙ።\nበቃሉ ቅደም ተከተል መሠረት ትክክለኛውን ፊደል ይንኩ (ይመቱ)።\nትክክለኛ ፊደል ግብ ካስገባ ለእናንተ ነጥብ ይጨምራል።\nበትክክል ያልሆነ ፊደል ካሳጠቀ ለግብ ጠባቂ ነጥብ ይጨምራል።\nሁሉም ፊደላት ከተመቱ በኋላ ጨዋታው ይያበቃል።"}},"ar":{"stringUnit":{"state":"needs_review","value":"اضغط الحروف بالترتيب الصحيح نحو المرمى لتسجّل.\nاضغط لركل الحرف الصحيح حسب ترتيب الكلمة.\nهدف بالحرف الصحيح يمنحك نقطة.\nإضاعة بالحرف الخاطئ تمنح الحارس نقطة.\nتنتهي اللعبة بعد ركل جميع الحروف."}},"de":{"stringUnit":{"state":"needs_review","value":"Tippt die Buchstaben in der richtigen Reihenfolge zum Tor, um zu punkten.\nTippt auf den richtigen Buchstaben entsprechend der Wortreihenfolge.\nEin Tor mit dem richtigen Buchstaben bringt euch einen Punkt.\nEin falscher Buchstabe gibt dem Torwart einen Punkt.\nDas Spiel endet, nachdem alle Buchstaben benutzt wurden."}},"en":{"stringUnit":{"state":"translated","value":"Tap letters in the correct order to kick toward the goal.\nA goal with the right letter earns you a point.\nMissing or being saved with a wrong letter gives the keeper a point.\nThe round continues until the word is complete."}},"es":{"stringUnit":{"state":"needs_review","value":"Toca las letras en el orden correcto hacia la portería para marcar.\nToca para patear la letra correcta según el orden de la palabra.\nUn gol con la letra correcta te da un punto.\nFallar con una letra incorrecta da un punto al portero.\nEl juego termina después de patear todas las letras."}},"fr":{"stringUnit":{"state":"needs_review","value":"Touchez les lettres dans le bon ordre vers le but pour marquer.\nTouchez pour frapper la bonne lettre selon l\u0027ordre du mot.\nUn but avec la bonne lettre vous donne un point.\nUn tir raté avec une mauvaise lettre donne un point au gardien.\nLe jeu se termine après avoir frappé toutes les lettres."}},"nl":{"stringUnit":{"state":"needs_review","value":"Tik op de letters in de juiste volgorde naar het doel om te scoren.\nTik op de juiste letter volgens de volgorde van het woord.\nEen goal met de juiste letter levert een punt op.\nEen verkeerde letter geeft een punt aan de keeper.\nHet spel eindigt nadat alle letters zijn gebruikt."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Toque as letras na ordem correta até o gol para marcar.\nToque para chutar a letra correta seguindo a ordem da palavra.\nUm gol com a letra certa vale um ponto.\nErrar a letra dá um ponto para o goleiro.\nO jogo termina quando todas as letras forem chutadas."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Toca as letras pela ordem correta em direção à baliza para marcar.\nToca para chutar a letra certa pela ordem da palavra.\nUm golo com a letra certa dá-te um ponto.\nFalhar com a letra errada dá um ponto ao guarda-redes.\nO jogo termina depois de chutares todas as letras."}},"ru":{"stringUnit":{"state":"needs_review","value":"Нажимай буквы в правильном порядке к воротам, чтобы забить гол.\nНажимай, чтобы ударить правильную букву в соответствии с порядком слова.\nГол с правильной буквой приносит тебе очко.\nПромах с неправильной буквой приносит очко вратарю.\nИгра заканчивается после удара по всем буквам."}}}},
                    "Drag letters upward in the correct order to kick toward the goal.\nA goal with the right letter earns you a point.\nMissing or being saved with a wrong letter gives the keeper a point.\nThe round continues until the word is complete.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ፊደላቱን በትክክለኛው ቅደም ተከተል ወደ ላይ ጎትተው ወደ ግቡ ይምቱ።\nበቃሉ ቅደም ተከተል መሠረት ትክክለኛውን ፊደል ወደ ላይ ይጎትቱ።\nትክክለኛ ፊደል ግብ ካስገባ ለእናንተ ነጥብ ይጨምራል።\nበትክክል ያልሆነ ፊደል ካሳጠቀ ለግብ ጠባቂ ነጥብ ይጨምራል።\nሁሉም ፊደላት ከተመቱ በኋላ ጨዋታው ይያበቃል።"}},"ar":{"stringUnit":{"state":"needs_review","value":"اسحب الحروف إلى الأعلى بالترتيب الصحيح لركلها نحو المرمى.\nاسحب الحرف الصحيح إلى الأعلى حسب ترتيب الكلمة.\nهدف بالحرف الصحيح يمنحك نقطة.\nإضاعة بالحرف الخاطئ تمنح الحارس نقطة.\nتنتهي اللعبة بعد ركل جميع الحروف."}},"de":{"stringUnit":{"state":"needs_review","value":"Zieht die Buchstaben in der richtigen Reihenfolge nach oben, um sie zum Tor zu schießen.\nZieht den richtigen Buchstaben entsprechend der Wortreihenfolge nach oben.\nEin Tor mit dem richtigen Buchstaben bringt euch einen Punkt.\nEin falscher Buchstabe gibt dem Torwart einen Punkt.\nDas Spiel endet, nachdem alle Buchstaben benutzt wurden."}},"en":{"stringUnit":{"state":"translated","value":"Drag letters upward in the correct order to kick toward the goal.\nA goal with the right letter earns you a point.\nMissing or being saved with a wrong letter gives the keeper a point.\nThe round continues until the word is complete."}},"es":{"stringUnit":{"state":"needs_review","value":"Arrastra las letras hacia arriba en el orden correcto para patearlas hacia la portería.\nArrastra la letra correcta hacia arriba según el orden de la palabra.\nUn gol con la letra correcta te da un punto.\nFallar con una letra incorrecta da un punto al portero.\nEl juego termina después de patear todas las letras."}},"fr":{"stringUnit":{"state":"needs_review","value":"Faites glisser les lettres vers le haut dans le bon ordre pour tirer vers le but.\nFaites glisser la bonne lettre vers le haut selon l\u0027ordre du mot.\nUn but avec la bonne lettre vous donne un point.\nUn tir raté avec une mauvaise lettre donne un point au gardien.\nLe jeu se termine après avoir frappé toutes les lettres."}},"nl":{"stringUnit":{"state":"needs_review","value":"Sleep de letters in de juiste volgorde omhoog om ze naar het doel te schieten.\nSleep de juiste letter omhoog volgens de volgorde van het woord.\nEen goal met de juiste letter levert een punt op.\nEen verkeerde letter geeft een punt aan de keeper.\nHet spel eindigt nadat alle letters zijn gebruikt."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Arraste as letras para cima na ordem correta para chutá-las em direção ao gol.\nArraste a letra correta para cima seguindo a ordem da palavra.\nUm gol com a letra certa vale um ponto.\nErrar a letra dá um ponto para o goleiro.\nO jogo termina quando todas as letras forem chutadas."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Arrasta as letras para cima pela ordem correta para as chutares em direção à baliza.\nArrasta a letra certa para cima pela ordem da palavra.\nUm golo com a letra certa dá-te um ponto.\nFalhar com a letra errada dá um ponto ao guarda-redes.\nO jogo termina depois de chutares todas as letras."}},"ru":{"stringUnit":{"state":"needs_review","value":"Перетаскивай буквы вверх в правильном порядке, чтобы ударить по воротам.\nПеретаскивай правильную букву вверх в соответствии с порядком слова.\nГол с правильной буквой приносит тебе очко.\nПромах с неправильной буквой приносит очко вратарю.\nИгра заканчивается после удара по всем буквам."}}}},
                    "Home": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"translated","value":"ወደ መነሻ ገጽ ተመለስ"}},"ar":{"stringUnit":{"state":"translated","value":"العودة إلى الشاشة الرئيسية"}},"de":{"stringUnit":{"state":"translated","value":"Zurück zum Startbildschirm"}},"en":{"stringUnit":{"state":"translated","value":"Home"}},"es":{"stringUnit":{"state":"translated","value":"Volver a la pantalla de inicio"}},"fr":{"stringUnit":{"state":"translated","value":"Retour à l\u0027écran d\u0027accueil"}},"nl":{"stringUnit":{"state":"translated","value":"Terug naar het beginscherm"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Voltar para a tela inicial"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Voltar ao ecrã inicial"}},"ru":{"stringUnit":{"state":"translated","value":"Вернуться на главный экран"}}}},
