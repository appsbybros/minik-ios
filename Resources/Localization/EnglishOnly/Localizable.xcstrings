                    "Welcome to Minik!": {"extractionState":"manual","comment":"Android reference: welcome_to_minik_speech","localizations":{"en":{"stringUnit":{"state":"translated","value":"Welcome to Minik!"}},"am":{"stringUnit":{"state":"translated","value":"ወደ ሚኒክ እንኳን ደህና መጡ"}},"ar":{"stringUnit":{"state":"translated","value":"مرحبًا بك في مينيك"}},"de":{"stringUnit":{"state":"translated","value":"Willkommen bei Minik"}},"es":{"stringUnit":{"state":"translated","value":"Te damos la bienvenida a Minik"}},"fr":{"stringUnit":{"state":"translated","value":"Bienvenue sur Minik"}},"nl":{"stringUnit":{"state":"translated","value":"Welkom bij Minik"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Boas-vindas ao Minik"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Boas-vindas ao Minik"}},"ru":{"stringUnit":{"state":"translated","value":"Добро пожаловать в Minik"}}}},
