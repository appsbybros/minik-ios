                    "Are you sure you want to delete?": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"እርግጠኛ ነዎት መሰረዝ እንደሚፈልጉ?"}},"ar":{"stringUnit":{"state":"needs_review","value":"هل تريد الحذف؟"}},"de":{"stringUnit":{"state":"needs_review","value":"Möchtet ihr wirklich löschen?"}},"en":{"stringUnit":{"state":"translated","value":"Are you sure you want to delete?"}},"es":{"stringUnit":{"state":"needs_review","value":"¿Seguro que quieres eliminarlo?"}},"fr":{"stringUnit":{"state":"needs_review","value":"Êtes-vous sûr de vouloir le supprimer ?"}},"he":{"stringUnit":{"state":"needs_review","value":"האם אתם בטוחים שברצונכם למחוק?"}},"nl":{"stringUnit":{"state":"needs_review","value":"Weet je zeker dat je dit wilt verwijderen?"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Tem certeza de que deseja excluir?"}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Tens a certeza de que queres apagar?"}},"ru":{"stringUnit":{"state":"needs_review","value":"Вы уверены, что хотите удалить?"}}}},
                    "Points and progress saved for this child on this device will be deleted.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"በዚህ መሣሪያ ላይ ለዚህ ልጅ የተቀመጡ ነጥቦች እና እድገት ይሰረዛሉ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"سيتم حذف ما حُفظ لهذا الطفل على هذا الجهاز من نقاط وتقدّم."}},"de":{"stringUnit":{"state":"needs_review","value":"Die auf diesem Gerät gespeicherten Punkte und Fortschritte dieses Kindes werden gelöscht."}},"en":{"stringUnit":{"state":"translated","value":"Points and progress saved for this child on this device will be deleted."}},"es":{"stringUnit":{"state":"needs_review","value":"Se eliminarán los puntos y el progreso de este niño guardados en este dispositivo."}},"fr":{"stringUnit":{"state":"needs_review","value":"Les points et les progrès de cet enfant enregistrés sur cet appareil seront supprimés."}},"he":{"stringUnit":{"state":"needs_review","value":"הנקודות וההתקדמות של הילד שנשמרו במכשיר הזה יימחקו."}},"nl":{"stringUnit":{"state":"needs_review","value":"De punten en voortgang die voor dit kind op dit apparaat zijn opgeslagen, worden verwijderd."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Os pontos e o progresso desta criança salvos neste dispositivo serão excluídos."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Os pontos e o progresso desta criança guardados neste dispositivo serão apagados."}},"ru":{"stringUnit":{"state":"needs_review","value":"Будут удалены очки и прогресс этого ребёнка, сохранённые на этом устройстве."}}}},
                    "Yes, delete": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"አዎ፣ ይሰርዙ"}},"ar":{"stringUnit":{"state":"needs_review","value":"نعم، حذف"}},"de":{"stringUnit":{"state":"needs_review","value":"Ja, löschen"}},"en":{"stringUnit":{"state":"translated","value":"Yes, delete"}},"es":{"stringUnit":{"state":"needs_review","value":"Sí, eliminar"}},"fr":{"stringUnit":{"state":"needs_review","value":"Oui, supprimer"}},"he":{"stringUnit":{"state":"needs_review","value":"כן, למחוק"}},"nl":{"stringUnit":{"state":"needs_review","value":"Ja, verwijderen"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Sim, excluir"}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Sim, apagar"}},"ru":{"stringUnit":{"state":"needs_review","value":"Да, удалить"}}}},
                    "Please enter a name.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"እባክዎ ስም ያስገቡ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"يرجى إدخال اسم."}},"de":{"stringUnit":{"state":"needs_review","value":"Bitte einen Namen eingeben."}},"en":{"stringUnit":{"state":"translated","value":"Please enter a name."}},"es":{"stringUnit":{"state":"needs_review","value":"Por favor, escribe un nombre."}},"fr":{"stringUnit":{"state":"needs_review","value":"Veuillez saisir un nom."}},"he":{"stringUnit":{"state":"needs_review","value":"יש להזין שם."}},"nl":{"stringUnit":{"state":"needs_review","value":"Vul een naam in."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Digite um nome."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Introduz um nome."}},"ru":{"stringUnit":{"state":"needs_review","value":"Пожалуйста, введите имя."}}}},
                    "Another child already has this name.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ይህ ስም ያለው ሌላ ልጅ አስቀድሞ አለ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"يوجد طفل آخر بهذا الاسم."}},"de":{"stringUnit":{"state":"needs_review","value":"Ein anderes Kind hat bereits diesen Namen."}},"en":{"stringUnit":{"state":"translated","value":"Another child already has this name."}},"es":{"stringUnit":{"state":"needs_review","value":"Ya hay otro niño con este nombre."}},"fr":{"stringUnit":{"state":"needs_review","value":"Un autre enfant porte déjà ce nom."}},"he":{"stringUnit":{"state":"needs_review","value":"כבר יש ילד עם השם הזה."}},"nl":{"stringUnit":{"state":"needs_review","value":"Er is al een kind met deze naam."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Já existe uma criança com esse nome."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Já existe uma criança com esse nome."}},"ru":{"stringUnit":{"state":"needs_review","value":"Ребёнок с таким именем уже есть."}}}},
                    "You can add up to 20 children.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"እስከ 20 ልጆች ማከል ይችላሉ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"يمكنك إضافة 20 طفلًا كحدٍّ أقصى."}},"de":{"stringUnit":{"state":"needs_review","value":"Es können bis zu 20 Kinder hinzugefügt werden."}},"en":{"stringUnit":{"state":"translated","value":"You can add up to 20 children."}},"es":{"stringUnit":{"state":"needs_review","value":"Puedes añadir hasta 20 niños."}},"fr":{"stringUnit":{"state":"needs_review","value":"Vous pouvez ajouter jusqu’à 20 enfants."}},"he":{"stringUnit":{"state":"needs_review","value":"אפשר להוסיף עד 20 ילדים."}},"nl":{"stringUnit":{"state":"needs_review","value":"Je kunt maximaal 20 kinderen toevoegen."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Você pode adicionar até 20 crianças."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Podes adicionar até 20 crianças."}},"ru":{"stringUnit":{"state":"needs_review","value":"Можно добавить до 20 детей."}}}},
                    "This app is designed for portrait. Please turn your iPad for the best experience.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ይህ መተግበሪያ በቁመት አቀማመጥ እንዲታይ ተደርጎ የተሰራ ነው። ለተሻለ ተሞክሮ እባክዎ iPadዎን ያዙሩ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"صُمّم هذا التطبيق للوضع العمودي. يُرجى تدوير جهاز iPad للحصول على أفضل تجربة."}},"de":{"stringUnit":{"state":"needs_review","value":"Diese App ist für das Hochformat gestaltet. Bitte das iPad für das beste Erlebnis hochkant drehen."}},"en":{"stringUnit":{"state":"translated","value":"This app is designed for portrait. Please turn your iPad for the best experience."}},"es":{"stringUnit":{"state":"needs_review","value":"Esta aplicación está diseñada para usarse en vertical. Por favor, gira el iPad para disfrutar de la mejor experiencia."}},"fr":{"stringUnit":{"state":"needs_review","value":"Cette application est conçue pour le mode portrait. Tournez votre iPad pour une expérience optimale."}},"he":{"stringUnit":{"state":"needs_review","value":"האפליקציה מותאמת לתצוגה לאורך. סובבו את ה־iPad כדי ליהנות מהחוויה הטובה ביותר."}},"nl":{"stringUnit":{"state":"needs_review","value":"Deze app is gemaakt voor staande weergave. Draai je iPad rechtop voor de beste ervaring."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Este app foi feito para ser usado na vertical. Gire o iPad para ter a melhor experiência."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Esta app foi pensada para a orientação vertical. Roda o iPad para teres a melhor experiência."}},"ru":{"stringUnit":{"state":"needs_review","value":"Приложение рассчитано на вертикальную ориентацию. Пожалуйста, поверните iPad — так будет удобнее."}}}},
                    "Hide this message": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ይህን መልዕክት ደብቅ"}},"ar":{"stringUnit":{"state":"needs_review","value":"إخفاء هذه الرسالة"}},"de":{"stringUnit":{"state":"needs_review","value":"Diese Meldung ausblenden"}},"en":{"stringUnit":{"state":"translated","value":"Hide this message"}},"es":{"stringUnit":{"state":"needs_review","value":"Ocultar este mensaje"}},"fr":{"stringUnit":{"state":"needs_review","value":"Masquer ce message"}},"he":{"stringUnit":{"state":"needs_review","value":"הסתרת ההודעה"}},"nl":{"stringUnit":{"state":"needs_review","value":"Dit bericht verbergen"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Ocultar esta mensagem"}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Ocultar esta mensagem"}},"ru":{"stringUnit":{"state":"needs_review","value":"Скрыть это сообщение"}}}},
                    "Drag the letters in the correct order to spell the word shown.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"የሚታየውን ቃል ለመጻፍ ፊደሎቹን በትክክለኛው ቅደም ተከተል ይጎትቱ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"اسحب الحروف بالترتيب الصحيح لتهجئة الكلمة المعروضة."}},"de":{"stringUnit":{"state":"needs_review","value":"Ziehe die Buchstaben in der richtigen Reihenfolge, um das angezeigte Wort zu schreiben."}},"en":{"stringUnit":{"state":"translated","value":"Drag the letters in the correct order to spell the word shown."}},"es":{"stringUnit":{"state":"needs_review","value":"Arrastra las letras en el orden correcto para formar la palabra que aparece."}},"fr":{"stringUnit":{"state":"needs_review","value":"Fais glisser les lettres dans le bon ordre pour écrire le mot affiché."}},"he":{"stringUnit":{"state":"needs_review","value":"גררו את האותיות לפי הסדר הנכון כדי להרכיב את המילה שמופיעה."}},"nl":{"stringUnit":{"state":"needs_review","value":"Sleep de letters in de juiste volgorde om het woord te spellen dat je ziet."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Arraste as letras na ordem certa para formar a palavra mostrada."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Arrasta as letras pela ordem certa para formar a palavra apresentada."}},"ru":{"stringUnit":{"state":"needs_review","value":"Перетаскивай буквы в правильном порядке, чтобы составить показанное слово."}}}},
                    "Tap Start to begin. Good luck!": {"extractionState":"manual","comment":"Android Minik strings.xml: the closing line of game_dialog_speak_text, read after the four Letter Soccer lines (2df3a2a)","localizations":{"am":{"stringUnit":{"state":"translated","value":"ጀምር ንኩ እና ጀምሩ። መልካም ዕድል!"}},"ar":{"stringUnit":{"state":"translated","value":"اضغط «ابدأ» لبدء اللعبة. حظًا موفقًا!"}},"de":{"stringUnit":{"state":"translated","value":"Tippt auf Start, um zu beginnen. Viel Erfolg!"}},"en":{"stringUnit":{"state":"translated","value":"Tap Start to begin. Good luck!"}},"es":{"stringUnit":{"state":"translated","value":"Toca Comenzar para empezar. ¡Buena suerte!"}},"fr":{"stringUnit":{"state":"translated","value":"Touchez Démarrer pour commencer. Bonne chance !"}},"he":{"stringUnit":{"state":"translated","value":"לחצו על להתחיל על מנת להתחיל את המשחק. בהצלחה!"}},"nl":{"stringUnit":{"state":"translated","value":"Tik op Start om te beginnen. Succes!"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Toque em Começar para iniciar. Boa sorte!"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Toca em Começar para iniciar. Boa sorte!"}},"ru":{"stringUnit":{"state":"translated","value":"Нажмите «Начать», чтобы начать. Удачи!"}}}},
                    "Try to score a goal against Minik with each letter.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"በእያንዳንዱ ፊደል በሚኒክ ላይ ግብ ለማስቆጠር ይሞክሩ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"حاول تسجيل هدف في مرمى مينيك بكل حرف."}},"de":{"stringUnit":{"state":"needs_review","value":"Versuche, mit jedem Buchstaben ein Tor gegen Minik zu schießen."}},"en":{"stringUnit":{"state":"translated","value":"Try to score a goal against Minik with each letter."}},"es":{"stringUnit":{"state":"needs_review","value":"Intenta marcarle un gol a Minik con cada letra."}},"fr":{"stringUnit":{"state":"needs_review","value":"Essaie de marquer un but contre Minik avec chaque lettre."}},"he":{"stringUnit":{"state":"needs_review","value":"נסו להבקיע גול נגד מיניק עם כל אות."}},"nl":{"stringUnit":{"state":"needs_review","value":"Probeer met elke letter te scoren tegen Minik."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Tente marcar um gol contra o Minik com cada letra."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Tenta marcar um golo contra o Minik com cada letra."}},"ru":{"stringUnit":{"state":"needs_review","value":"Постарайся каждой буквой забить гол в ворота Minik."}}}},
                    "Correct letter + goal = 1 point for you!": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ትክክለኛ ፊደል + ግብ = 1 ነጥብ ለእርስዎ!"}},"ar":{"stringUnit":{"state":"needs_review","value":"حرف صحيح + هدف = نقطة لك!"}},"de":{"stringUnit":{"state":"needs_review","value":"Richtiger Buchstabe + Tor = 1 Punkt für dich!"}},"en":{"stringUnit":{"state":"translated","value":"Correct letter + goal = 1 point for you!"}},"es":{"stringUnit":{"state":"needs_review","value":"Letra correcta + gol = ¡1 punto para ti!"}},"fr":{"stringUnit":{"state":"needs_review","value":"Bonne lettre + but = 1 point pour toi !"}},"he":{"stringUnit":{"state":"needs_review","value":"אות נכונה + גול = נקודה אחת לכם!"}},"nl":{"stringUnit":{"state":"needs_review","value":"Goede letter + goal = 1 punt voor jou!"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Letra certa + gol = 1 ponto para você!"}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Letra certa + golo = 1 ponto para ti!"}},"ru":{"stringUnit":{"state":"needs_review","value":"Правильная буква + гол = 1 очко тебе!"}}}},
                    "Wrong letter + no goal = 1 point for Minik!": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"የተሳሳተ ፊደል + ግብ የለም = 1 ነጥብ ለሚኒክ!"}},"ar":{"stringUnit":{"state":"needs_review","value":"حرف خاطئ + لا هدف = نقطة لمينيك!"}},"de":{"stringUnit":{"state":"needs_review","value":"Falscher Buchstabe + kein Tor = 1 Punkt für Minik!"}},"en":{"stringUnit":{"state":"translated","value":"Wrong letter + no goal = 1 point for Minik!"}},"es":{"stringUnit":{"state":"needs_review","value":"Letra incorrecta + sin gol = ¡1 punto para Minik!"}},"fr":{"stringUnit":{"state":"needs_review","value":"Mauvaise lettre + pas de but = 1 point pour Minik !"}},"he":{"stringUnit":{"state":"needs_review","value":"אות לא נכונה + בלי גול = נקודה אחת למיניק!"}},"nl":{"stringUnit":{"state":"needs_review","value":"Verkeerde letter + geen goal = 1 punt voor Minik!"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Letra errada + sem gol = 1 ponto para o Minik!"}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Letra errada + sem golo = 1 ponto para o Minik!"}},"ru":{"stringUnit":{"state":"needs_review","value":"Неправильная буква + нет гола = 1 очко Minik!"}}}},
                    "More Information": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ተጨማሪ መረጃ"}},"ar":{"stringUnit":{"state":"needs_review","value":"مزيد من المعلومات"}},"de":{"stringUnit":{"state":"needs_review","value":"Mehr Informationen"}},"en":{"stringUnit":{"state":"translated","value":"More Information"}},"es":{"stringUnit":{"state":"needs_review","value":"Más información"}},"fr":{"stringUnit":{"state":"needs_review","value":"Plus d’informations"}},"he":{"stringUnit":{"state":"needs_review","value":"מידע נוסף"}},"nl":{"stringUnit":{"state":"needs_review","value":"Meer informatie"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Mais informações"}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Mais informações"}},"ru":{"stringUnit":{"state":"needs_review","value":"Подробнее"}}}},
                    "Drag letters upward in the correct order, past the dashed line, to kick them toward the goal.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ፊደሎቹን ወደ ግብ ለመምታት በትክክለኛው ቅደም ተከተል፣ ከተቆራረጠው መስመር አልፈው፣ ወደ ላይ ይጎትቱ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"اسحب الحروف إلى الأعلى بالترتيب الصحيح، وتجاوز بها الخط المتقطع لتركلها نحو المرمى."}},"de":{"stringUnit":{"state":"needs_review","value":"Ziehe die Buchstaben in der richtigen Reihenfolge nach oben über die gestrichelte Linie, um sie aufs Tor zu schießen."}},"en":{"stringUnit":{"state":"translated","value":"Drag letters upward in the correct order, past the dashed line, to kick them toward the goal."}},"es":{"stringUnit":{"state":"needs_review","value":"Arrastra las letras hacia arriba en el orden correcto, hasta pasar la línea discontinua, para patearlas hacia la portería."}},"fr":{"stringUnit":{"state":"needs_review","value":"Fais glisser les lettres vers le haut dans le bon ordre, au-delà de la ligne en pointillés, pour tirer vers le but."}},"he":{"stringUnit":{"state":"needs_review","value":"גררו את האותיות כלפי מעלה לפי הסדר הנכון, אל מעבר לקו המקווקו, כדי לבעוט בהן לעבר השער."}},"nl":{"stringUnit":{"state":"needs_review","value":"Sleep de letters in de juiste volgorde omhoog, voorbij de stippellijn, om ze naar het doel te trappen."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Arraste as letras para cima na ordem certa, passando da linha tracejada, para chutá-las em direção ao gol."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Arrasta as letras para cima pela ordem certa, para lá da linha tracejada, para as chutares em direção à baliza."}},"ru":{"stringUnit":{"state":"needs_review","value":"Перетаскивай буквы вверх в правильном порядке, за пунктирную линию, чтобы ударить по воротам."}}}},
                    "Correct letter + no goal = no point, but the letter still goes into the word.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ትክክለኛ ፊደል + ግብ የለም = ነጥብ የለም፣ ግን ፊደሉ አሁንም ወደ ቃሉ ይገባል።"}},"ar":{"stringUnit":{"state":"needs_review","value":"حرف صحيح + لا هدف = لا نقاط، لكن الحرف يُضاف إلى الكلمة رغم ذلك."}},"de":{"stringUnit":{"state":"needs_review","value":"Richtiger Buchstabe + kein Tor = kein Punkt, aber der Buchstabe kommt trotzdem ins Wort."}},"en":{"stringUnit":{"state":"translated","value":"Correct letter + no goal = no point, but the letter still goes into the word."}},"es":{"stringUnit":{"state":"needs_review","value":"Letra correcta + sin gol = ningún punto, pero la letra pasa igualmente a la palabra."}},"fr":{"stringUnit":{"state":"needs_review","value":"Bonne lettre + pas de but = pas de point, mais la lettre s’ajoute quand même au mot."}},"he":{"stringUnit":{"state":"needs_review","value":"אות נכונה + בלי גול = אין נקודה, אבל האות עדיין נכנסת למילה."}},"nl":{"stringUnit":{"state":"needs_review","value":"Goede letter + geen goal = geen punt, maar de letter komt wel in het woord."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Letra certa + sem gol = nenhum ponto, mas a letra entra na palavra mesmo assim."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Letra certa + sem golo = nenhum ponto, mas a letra entra na palavra na mesma."}},"ru":{"stringUnit":{"state":"needs_review","value":"Правильная буква + нет гола = нет очка, но буква всё равно встаёт в слово."}}}},
                    "Wrong letter + goal = no point, and the letter comes back to try again.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"የተሳሳተ ፊደል + ግብ = ነጥብ የለም፣ ፊደሉም እንደገና ለመሞከር ይመለሳል።"}},"ar":{"stringUnit":{"state":"needs_review","value":"حرف خاطئ + هدف = لا نقاط، ويعود الحرف لتحاول مرة أخرى."}},"de":{"stringUnit":{"state":"needs_review","value":"Falscher Buchstabe + Tor = kein Punkt, und der Buchstabe kommt zurück für einen neuen Versuch."}},"en":{"stringUnit":{"state":"translated","value":"Wrong letter + goal = no point, and the letter comes back to try again."}},"es":{"stringUnit":{"state":"needs_review","value":"Letra incorrecta + gol = ningún punto, y la letra vuelve para que lo intentes de nuevo."}},"fr":{"stringUnit":{"state":"needs_review","value":"Mauvaise lettre + but = pas de point, et la lettre revient pour un nouvel essai."}},"he":{"stringUnit":{"state":"needs_review","value":"אות לא נכונה + גול = אין נקודה, והאות חוזרת כדי שתנסו שוב."}},"nl":{"stringUnit":{"state":"needs_review","value":"Verkeerde letter + goal = geen punt, en de letter komt terug zodat je het opnieuw kunt proberen."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Letra errada + gol = nenhum ponto, e a letra volta para você tentar de novo."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Letra errada + golo = nenhum ponto, e a letra volta para tentares outra vez."}},"ru":{"stringUnit":{"state":"needs_review","value":"Неправильная буква + гол = нет очка, а буква возвращается — можно попробовать ещё раз."}}}},
                    "When the word is complete, whoever has more points wins.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ቃሉ ሲጠናቀቅ የበለጠ ነጥብ ያለው ያሸንፋል።"}},"ar":{"stringUnit":{"state":"needs_review","value":"عندما تكتمل الكلمة، يفوز من لديه نقاط أكثر."}},"de":{"stringUnit":{"state":"needs_review","value":"Wenn das Wort fertig ist, gewinnt, wer mehr Punkte hat."}},"en":{"stringUnit":{"state":"translated","value":"When the word is complete, whoever has more points wins."}},"es":{"stringUnit":{"state":"needs_review","value":"Cuando se completa la palabra, gana quien tenga más puntos."}},"fr":{"stringUnit":{"state":"needs_review","value":"Quand le mot est terminé, celui qui a le plus de points gagne."}},"he":{"stringUnit":{"state":"needs_review","value":"כשהמילה מושלמת, מנצח מי שצבר יותר נקודות."}},"nl":{"stringUnit":{"state":"needs_review","value":"Als het woord af is, wint wie de meeste punten heeft."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Quando a palavra estiver completa, quem tiver mais pontos vence."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Quando a palavra estiver completa, ganha quem tiver mais pontos."}},"ru":{"stringUnit":{"state":"needs_review","value":"Когда слово составлено, побеждает тот, у кого больше очков."}}}},
                    "Tap the word or the picture to hear it again.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"እንደገና ለመስማት ቃሉን ወይም ምስሉን ይንኩ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"اضغط على الكلمة أو الصورة لتسمعها مرة أخرى."}},"de":{"stringUnit":{"state":"needs_review","value":"Tippe auf das Wort oder das Bild, um es noch einmal zu hören."}},"en":{"stringUnit":{"state":"translated","value":"Tap the word or the picture to hear it again."}},"es":{"stringUnit":{"state":"needs_review","value":"Toca la palabra o la imagen para volver a escucharla."}},"fr":{"stringUnit":{"state":"needs_review","value":"Touche le mot ou l’image pour l’entendre à nouveau."}},"he":{"stringUnit":{"state":"needs_review","value":"לחצו על המילה או על התמונה כדי לשמוע אותה שוב."}},"nl":{"stringUnit":{"state":"needs_review","value":"Tik op het woord of de afbeelding om het nog een keer te horen."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Toque na palavra ou na imagem para ouvi-la de novo."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Toca na palavra ou na imagem para a ouvires outra vez."}},"ru":{"stringUnit":{"state":"needs_review","value":"Нажми на слово или картинку, чтобы послушать ещё раз."}}}},
                    "Expanded": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ተዘርግቷል"}},"ar":{"stringUnit":{"state":"needs_review","value":"موسّع"}},"de":{"stringUnit":{"state":"needs_review","value":"Ausgeklappt"}},"en":{"stringUnit":{"state":"translated","value":"Expanded"}},"es":{"stringUnit":{"state":"needs_review","value":"Expandido"}},"fr":{"stringUnit":{"state":"needs_review","value":"Développé"}},"he":{"stringUnit":{"state":"needs_review","value":"מורחב"}},"nl":{"stringUnit":{"state":"needs_review","value":"Uitgevouwen"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Expandido"}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Expandido"}},"ru":{"stringUnit":{"state":"needs_review","value":"Развёрнуто"}}}},
                    "Collapsed": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ተሰብስቧል"}},"ar":{"stringUnit":{"state":"needs_review","value":"مطويّ"}},"de":{"stringUnit":{"state":"needs_review","value":"Eingeklappt"}},"en":{"stringUnit":{"state":"translated","value":"Collapsed"}},"es":{"stringUnit":{"state":"needs_review","value":"Contraído"}},"fr":{"stringUnit":{"state":"needs_review","value":"Réduit"}},"he":{"stringUnit":{"state":"needs_review","value":"מכווץ"}},"nl":{"stringUnit":{"state":"needs_review","value":"Samengevouwen"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Recolhido"}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Recolhido"}},"ru":{"stringUnit":{"state":"needs_review","value":"Свёрнуто"}}}},
                    "Read aloud": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"translated","value":"ጮክ ብሎ ማንበብ"}},"ar":{"stringUnit":{"state":"translated","value":"القراءة بصوت عالٍ"}},"de":{"stringUnit":{"state":"translated","value":"Vorlesen"}},"en":{"stringUnit":{"state":"translated","value":"Read aloud"}},"es":{"stringUnit":{"state":"translated","value":"Leer en voz alta"}},"fr":{"stringUnit":{"state":"translated","value":"Lecture à voix haute"}},"he":{"stringUnit":{"state":"translated","value":"הקראה בקול"}},"nl":{"stringUnit":{"state":"translated","value":"Voorlezen"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ler em voz alta"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Ler em voz alta"}},"ru":{"stringUnit":{"state":"translated","value":"Чтение вслух"}}}},
                    "Read each instruction and exercise aloud when it appears.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"translated","value":"እያንዳንዱን መመሪያ እና መልመጃ ሲታይ ጮክ ብሎ ያነባል።"}},"ar":{"stringUnit":{"state":"translated","value":"قراءة كل تعليمة وكل تمرين بصوت عالٍ عند ظهوره."}},"de":{"stringUnit":{"state":"translated","value":"Jede Anleitung und jede Aufgabe wird vorgelesen, sobald sie erscheint."}},"en":{"stringUnit":{"state":"translated","value":"Read each instruction and exercise aloud when it appears."}},"es":{"stringUnit":{"state":"translated","value":"Lee en voz alta cada instrucción y cada ejercicio cuando aparece."}},"fr":{"stringUnit":{"state":"translated","value":"Lit à voix haute chaque consigne et chaque exercice dès qu’ils apparaissent."}},"he":{"stringUnit":{"state":"translated","value":"כל הוראה וכל תרגיל מוקראים בקול כשהם מופיעים."}},"nl":{"stringUnit":{"state":"translated","value":"Leest elke instructie en elke oefening voor zodra die verschijnt."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Lê em voz alta cada instrução e cada exercício quando aparecem."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Lê em voz alta cada instrução e cada exercício quando aparecem."}},"ru":{"stringUnit":{"state":"translated","value":"Читает вслух каждое задание и каждый пример, когда они появляются."}}}},
                    "what": {"comment":"Read aloud in place of the missing number of a Math exercise: 3 + □ = 7 is read \"3 plus what equals 7\".","extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"translated","value":"ስንት"}},"ar":{"stringUnit":{"state":"translated","value":"كم"}},"de":{"stringUnit":{"state":"translated","value":"wie viel"}},"en":{"stringUnit":{"state":"translated","value":"what"}},"es":{"stringUnit":{"state":"translated","value":"cuánto"}},"fr":{"stringUnit":{"state":"translated","value":"combien"}},"he":{"stringUnit":{"state":"translated","value":"כמה"}},"nl":{"stringUnit":{"state":"translated","value":"hoeveel"}},"pt-BR":{"stringUnit":{"state":"translated","value":"quanto"}},"pt-PT":{"stringUnit":{"state":"translated","value":"quanto"}},"ru":{"stringUnit":{"state":"translated","value":"сколько"}}}},
                    "Reading voice": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"translated","value":"የንባብ ድምፅ"}},"ar":{"stringUnit":{"state":"translated","value":"صوت القراءة"}},"de":{"stringUnit":{"state":"translated","value":"Vorlesestimme"}},"en":{"stringUnit":{"state":"translated","value":"Reading voice"}},"es":{"stringUnit":{"state":"translated","value":"Voz de lectura"}},"fr":{"stringUnit":{"state":"translated","value":"Voix de lecture"}},"he":{"stringUnit":{"state":"translated","value":"קול ההקראה"}},"nl":{"stringUnit":{"state":"translated","value":"Voorleesstem"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Voz de leitura"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Voz de leitura"}},"ru":{"stringUnit":{"state":"translated","value":"Голос для чтения"}}}},
                    "For a clearer voice, search Settings for “Voices” and download an Enhanced voice.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"translated","value":"ለበለጠ ግልጽ ድምፅ፣ በቅንብሮች ውስጥ “Voices” ይፈልጉ እና የተሻሻለ ድምፅ ያውርዱ።"}},"ar":{"stringUnit":{"state":"translated","value":"للحصول على صوت أوضح، ابحث عن «الأصوات» في الإعدادات ونزّل صوتًا محسّنًا."}},"de":{"stringUnit":{"state":"translated","value":"Für eine klarere Stimme in den Einstellungen nach „Stimmen“ suchen und eine erweiterte Stimme laden."}},"en":{"stringUnit":{"state":"translated","value":"For a clearer voice, search Settings for “Voices” and download an Enhanced voice."}},"es":{"stringUnit":{"state":"translated","value":"Para una voz más clara, busca «Voces» en Ajustes y descarga una voz mejorada."}},"fr":{"stringUnit":{"state":"translated","value":"Pour une voix plus claire, recherchez « Voix » dans Réglages et téléchargez une voix améliorée."}},"he":{"stringUnit":{"state":"translated","value":"לקול ברור יותר: חפשו „קולות” בהגדרות והורידו קול משופר."}},"nl":{"stringUnit":{"state":"translated","value":"Voor een duidelijkere stem: zoek in Instellingen naar ‘Stemmen’ en download een verbeterde stem."}},"pt-BR":{"stringUnit":{"state":"translated","value":"Para uma voz mais clara, procure “Vozes” em Ajustes e baixe uma voz aprimorada."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Para uma voz mais clara, procure “Vozes” nas Definições e descarregue uma voz melhorada."}},"ru":{"stringUnit":{"state":"translated","value":"Для более чёткого голоса найдите «Голоса» в Настройках и загрузите улучшенный голос."}}}},
                    "No voice on this device": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"translated","value":"በዚህ መሣሪያ ላይ ድምፅ የለም"}},"ar":{"stringUnit":{"state":"translated","value":"لا يوجد صوت على هذا الجهاز"}},"de":{"stringUnit":{"state":"translated","value":"Keine Stimme auf diesem Gerät"}},"en":{"stringUnit":{"state":"translated","value":"No voice on this device"}},"es":{"stringUnit":{"state":"translated","value":"No hay voz en este dispositivo"}},"fr":{"stringUnit":{"state":"translated","value":"Aucune voix sur cet appareil"}},"he":{"stringUnit":{"state":"translated","value":"אין קול במכשיר הזה"}},"nl":{"stringUnit":{"state":"translated","value":"Geen stem op dit apparaat"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Nenhuma voz neste dispositivo"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Nenhuma voz neste dispositivo"}},"ru":{"stringUnit":{"state":"translated","value":"На этом устройстве нет голоса"}}}},
                    "Automatic (%@)": {"comment":"Parent Area > Reading voice: the automatic choice, with the voice it uses now (a voice name such as Carmit).","extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"translated","value":"ራስ-ሰር (%@)"}},"ar":{"stringUnit":{"state":"translated","value":"تلقائي (%@)"}},"de":{"stringUnit":{"state":"translated","value":"Automatisch (%@)"}},"en":{"stringUnit":{"state":"translated","value":"Automatic (%@)"}},"es":{"stringUnit":{"state":"translated","value":"Automática (%@)"}},"fr":{"stringUnit":{"state":"translated","value":"Automatique (%@)"}},"he":{"stringUnit":{"state":"translated","value":"אוטומטי (%@)"}},"nl":{"stringUnit":{"state":"translated","value":"Automatisch (%@)"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Automática (%@)"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Automática (%@)"}},"ru":{"stringUnit":{"state":"translated","value":"Автоматически (%@)"}}}},
                    "%@ (Enhanced)": {"comment":"A device text-to-speech voice of Enhanced quality, as iOS Settings names it (Carmit (Enhanced)).","extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"translated","value":"%@ (የተሻሻለ)"}},"ar":{"stringUnit":{"state":"translated","value":"%@ (محسّن)"}},"de":{"stringUnit":{"state":"translated","value":"%@ (erweitert)"}},"en":{"stringUnit":{"state":"translated","value":"%@ (Enhanced)"}},"es":{"stringUnit":{"state":"translated","value":"%@ (mejorada)"}},"fr":{"stringUnit":{"state":"translated","value":"%@ (améliorée)"}},"he":{"stringUnit":{"state":"translated","value":"%@ (משופר)"}},"nl":{"stringUnit":{"state":"translated","value":"%@ (verbeterd)"}},"pt-BR":{"stringUnit":{"state":"translated","value":"%@ (aprimorada)"}},"pt-PT":{"stringUnit":{"state":"translated","value":"%@ (melhorada)"}},"ru":{"stringUnit":{"state":"translated","value":"%@ (улучшенный)"}}}},
                    "%@ (Premium)": {"comment":"A device text-to-speech voice of Premium quality, as iOS Settings names it.","extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"translated","value":"%@ (ፕሪሚየም)"}},"ar":{"stringUnit":{"state":"translated","value":"%@ (ممتاز)"}},"de":{"stringUnit":{"state":"translated","value":"%@ (Premium)"}},"en":{"stringUnit":{"state":"translated","value":"%@ (Premium)"}},"es":{"stringUnit":{"state":"translated","value":"%@ (prémium)"}},"fr":{"stringUnit":{"state":"translated","value":"%@ (premium)"}},"he":{"stringUnit":{"state":"translated","value":"%@ (פרימיום)"}},"nl":{"stringUnit":{"state":"translated","value":"%@ (premium)"}},"pt-BR":{"stringUnit":{"state":"translated","value":"%@ (Premium)"}},"pt-PT":{"stringUnit":{"state":"translated","value":"%@ (Premium)"}},"ru":{"stringUnit":{"state":"translated","value":"%@ (премиум)"}}}},
                    "Compare voices": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"Compare voices"}},"ar":{"stringUnit":{"state":"needs_review","value":"Compare voices"}},"de":{"stringUnit":{"state":"needs_review","value":"Compare voices"}},"en":{"stringUnit":{"state":"translated","value":"Compare voices"}},"es":{"stringUnit":{"state":"needs_review","value":"Compare voices"}},"fr":{"stringUnit":{"state":"needs_review","value":"Compare voices"}},"he":{"stringUnit":{"state":"translated","value":"השוואת קולות"}},"nl":{"stringUnit":{"state":"needs_review","value":"Compare voices"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Compare voices"}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Compare voices"}},"ru":{"stringUnit":{"state":"needs_review","value":"Compare voices"}}}},
                    "Compare the exact words and voices below. Nothing changes in the app until you save a voice.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"Compare the exact words and voices below. Nothing changes in the app until you save a voice."}},"ar":{"stringUnit":{"state":"needs_review","value":"Compare the exact words and voices below. Nothing changes in the app until you save a voice."}},"de":{"stringUnit":{"state":"needs_review","value":"Compare the exact words and voices below. Nothing changes in the app until you save a voice."}},"en":{"stringUnit":{"state":"translated","value":"Compare the exact words and voices below. Nothing changes in the app until you save a voice."}},"es":{"stringUnit":{"state":"needs_review","value":"Compare the exact words and voices below. Nothing changes in the app until you save a voice."}},"fr":{"stringUnit":{"state":"needs_review","value":"Compare the exact words and voices below. Nothing changes in the app until you save a voice."}},"he":{"stringUnit":{"state":"translated","value":"השוו בין המילים והקולות שלמטה. דבר לא ישתנה באפליקציה עד שתשמרו קול."}},"nl":{"stringUnit":{"state":"needs_review","value":"Compare the exact words and voices below. Nothing changes in the app until you save a voice."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Compare the exact words and voices below. Nothing changes in the app until you save a voice."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Compare the exact words and voices below. Nothing changes in the app until you save a voice."}},"ru":{"stringUnit":{"state":"needs_review","value":"Compare the exact words and voices below. Nothing changes in the app until you save a voice."}}}},
