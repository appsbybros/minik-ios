                    "Practice activity": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"የልምምድ እንቅስቃሴ"}},"ar":{"stringUnit":{"state":"needs_review","value":"نشاط تدريبي"}},"de":{"stringUnit":{"state":"needs_review","value":"Übung"}},"en":{"stringUnit":{"state":"translated","value":"Practice activity"}},"es":{"stringUnit":{"state":"needs_review","value":"Actividad de práctica"}},"fr":{"stringUnit":{"state":"needs_review","value":"Activité d’entraînement"}},"he":{"stringUnit":{"state":"needs_review","value":"פעילות תרגול"}},"nl":{"stringUnit":{"state":"needs_review","value":"Oefenactiviteit"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Atividade de prática"}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Atividade de prática"}},"ru":{"stringUnit":{"state":"needs_review","value":"Учебное занятие"}}}},
                    "Practice attempts": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"የልምምድ ሙከራዎች"}},"ar":{"stringUnit":{"state":"needs_review","value":"محاولات التدريب"}},"de":{"stringUnit":{"state":"needs_review","value":"Übungsversuche"}},"en":{"stringUnit":{"state":"translated","value":"Practice attempts"}},"es":{"stringUnit":{"state":"needs_review","value":"Intentos de práctica"}},"fr":{"stringUnit":{"state":"needs_review","value":"Tentatives d’entraînement"}},"he":{"stringUnit":{"state":"needs_review","value":"ניסיונות תרגול"}},"nl":{"stringUnit":{"state":"needs_review","value":"Oefenpogingen"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Tentativas de prática"}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Tentativas de prática"}},"ru":{"stringUnit":{"state":"needs_review","value":"Всего попыток"}}}},
                    "Practice time": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"የልምምድ ጊዜ"}},"ar":{"stringUnit":{"state":"needs_review","value":"وقت التدريب"}},"de":{"stringUnit":{"state":"needs_review","value":"Übungszeit"}},"en":{"stringUnit":{"state":"translated","value":"Practice time"}},"es":{"stringUnit":{"state":"needs_review","value":"Tiempo de práctica"}},"fr":{"stringUnit":{"state":"needs_review","value":"Temps d’entraînement"}},"he":{"stringUnit":{"state":"needs_review","value":"זמן תרגול"}},"nl":{"stringUnit":{"state":"needs_review","value":"Oefentijd"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Tempo de prática"}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Tempo de prática"}},"ru":{"stringUnit":{"state":"needs_review","value":"Время практики"}}}},
                    "Returns to learning settings": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ወደ መማሪያ ቅንብሮች ይመለሳል"}},"ar":{"stringUnit":{"state":"needs_review","value":"يعود إلى إعدادات التعلّم"}},"de":{"stringUnit":{"state":"needs_review","value":"Kehrt zu den Lerneinstellungen zurück"}},"en":{"stringUnit":{"state":"translated","value":"Returns to learning settings"}},"es":{"stringUnit":{"state":"needs_review","value":"Vuelve a los ajustes de aprendizaje"}},"fr":{"stringUnit":{"state":"needs_review","value":"Revient aux réglages d’apprentissage"}},"he":{"stringUnit":{"state":"needs_review","value":"חוזר להגדרות הלמידה"}},"nl":{"stringUnit":{"state":"needs_review","value":"Gaat terug naar de leerinstellingen"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Volta às configurações de aprendizagem"}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Volta às definições de aprendizagem"}},"ru":{"stringUnit":{"state":"needs_review","value":"Возвращает к настройкам обучения"}}}},
                    "Don’t show automatically": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"በራስ-ሰር አታሳይ"}},"ar":{"stringUnit":{"state":"needs_review","value":"عدم العرض تلقائيًا"}},"de":{"stringUnit":{"state":"needs_review","value":"Nicht automatisch anzeigen"}},"en":{"stringUnit":{"state":"translated","value":"Don’t show automatically"}},"es":{"stringUnit":{"state":"needs_review","value":"No mostrar automáticamente"}},"fr":{"stringUnit":{"state":"needs_review","value":"Ne pas afficher automatiquement"}},"he":{"stringUnit":{"state":"needs_review","value":"לא להציג אוטומטית"}},"nl":{"stringUnit":{"state":"needs_review","value":"Niet automatisch tonen"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Não mostrar automaticamente"}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Não mostrar automaticamente"}},"ru":{"stringUnit":{"state":"needs_review","value":"Не показывать автоматически"}}}},
                    "Won’t be shown automatically again": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ከእንግዲህ በራስ-ሰር አይታይም"}},"ar":{"stringUnit":{"state":"needs_review","value":"لن يتم العرض تلقائيًا مرة أخرى"}},"de":{"stringUnit":{"state":"needs_review","value":"Wird nicht mehr automatisch angezeigt"}},"en":{"stringUnit":{"state":"translated","value":"Won’t be shown automatically again"}},"es":{"stringUnit":{"state":"needs_review","value":"Ya no se mostrará automáticamente"}},"fr":{"stringUnit":{"state":"needs_review","value":"Ne sera plus affiché automatiquement"}},"he":{"stringUnit":{"state":"needs_review","value":"לא יוצג אוטומטית יותר"}},"nl":{"stringUnit":{"state":"needs_review","value":"Wordt niet meer automatisch getoond"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Não será mais exibido automaticamente"}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Já não será apresentado automaticamente"}},"ru":{"stringUnit":{"state":"needs_review","value":"Больше не будет показываться автоматически"}}}},
                    "How to play": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"እንዴት እንደሚጫወቱ"}},"ar":{"stringUnit":{"state":"needs_review","value":"طريقة اللعب"}},"de":{"stringUnit":{"state":"needs_review","value":"So wird gespielt"}},"en":{"stringUnit":{"state":"translated","value":"How to play"}},"es":{"stringUnit":{"state":"needs_review","value":"Cómo jugar"}},"fr":{"stringUnit":{"state":"needs_review","value":"Comment jouer"}},"he":{"stringUnit":{"state":"needs_review","value":"איך משחקים"}},"nl":{"stringUnit":{"state":"needs_review","value":"Zo speel je"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Como jogar"}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Como jogar"}},"ru":{"stringUnit":{"state":"needs_review","value":"Как играть"}}}},
                    "Let's start!": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"እንጀምር!"}},"ar":{"stringUnit":{"state":"needs_review","value":"هيا نبدأ!"}},"de":{"stringUnit":{"state":"needs_review","value":"Los geht’s!"}},"en":{"stringUnit":{"state":"translated","value":"Let's start!"}},"es":{"stringUnit":{"state":"needs_review","value":"¡Empecemos!"}},"fr":{"stringUnit":{"state":"needs_review","value":"C’est parti !"}},"he":{"stringUnit":{"state":"needs_review","value":"בואו נתחיל!"}},"nl":{"stringUnit":{"state":"needs_review","value":"Aan de slag!"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Vamos começar!"}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Vamos começar!"}},"ru":{"stringUnit":{"state":"needs_review","value":"Начнём!"}}}},
                    "Each card teaches one math fact with a picture. Look at it, listen, and say it out loud. Then tap Next to see the next card.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"እያንዳንዱ ካርድ አንድ የሂሳብ ስሌት በምስል ያስተምራል። ይመልከቱት፣ ያዳምጡ እና ጮክ ብለው ይናገሩት። ከዚያም ቀጣዩን ካርድ ለማየት «ቀጣይ» የሚለውን ይንኩ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"كل بطاقة تعلّمك حقيقة رياضية واحدة مع صورة. انظر إليها، واستمع، وردّدها بصوت عالٍ. ثم اضغط على «التالي» لترى البطاقة التالية."}},"de":{"stringUnit":{"state":"needs_review","value":"Jede Karte bringt dir mit einem Bild etwas Neues in Mathe bei. Schau sie dir an, hör zu und sprich es laut aus. Tippe dann auf „Weiter“, um die nächste Karte zu sehen."}},"en":{"stringUnit":{"state":"translated","value":"Each card teaches one math fact with a picture. Look at it, listen, and say it out loud. Then tap Next to see the next card."}},"es":{"stringUnit":{"state":"needs_review","value":"Cada tarjeta enseña un dato de matemáticas con una imagen. Mírala, escucha y dilo en voz alta. Luego toca Siguiente para ver la próxima tarjeta."}},"fr":{"stringUnit":{"state":"needs_review","value":"Chaque carte t’apprend un fait mathématique avec une image. Regarde-la, écoute et dis-le à voix haute. Ensuite, touche « Suivant » pour voir la carte suivante."}},"he":{"stringUnit":{"state":"needs_review","value":"כל כרטיס מלמד עובדה אחת במתמטיקה, עם תמונה. הסתכלו עליו, הקשיבו ואמרו את העובדה בקול. אחר כך הקישו על ״הבא״ כדי לראות את הכרטיס הבא."}},"nl":{"stringUnit":{"state":"needs_review","value":"Elke kaart leert je één rekenfeit, met een afbeelding. Kijk ernaar, luister en zeg het hardop. Tik daarna op “Volgende” om de volgende kaart te zien."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Cada cartão ensina um fato matemático com uma imagem. Olhe o cartão, ouça e diga o fato em voz alta. Depois toque em “Próximo” para ver o próximo cartão."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Cada cartão ensina um facto matemático com uma imagem. Olha para o cartão, ouve e diz o facto em voz alta. Depois toca em “Seguinte” para veres o cartão seguinte."}},"ru":{"stringUnit":{"state":"needs_review","value":"Каждая карточка знакомит с одним примером и картинкой к нему. Посмотри на неё, послушай и произнеси пример вслух. Потом нажми «Далее», чтобы увидеть следующую карточку."}}}},
                    "Here are all the facts of this level in one table. Tap a fact to hear it. Read the table again and again to remember the facts.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"የዚህ ደረጃ ስሌቶች በሙሉ እዚህ በአንድ ሰንጠረዥ ውስጥ አሉ። ለመስማት አንድ ስሌት ይንኩ። ስሌቶቹን ለማስታወስ ሰንጠረዡን ደጋግመው ያንብቡ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"إليك كل حقائق هذا المستوى في جدول واحد. اضغط على حقيقة لتسمعها. اقرأ الجدول مرة بعد مرة لتتذكّر الحقائق."}},"de":{"stringUnit":{"state":"needs_review","value":"Hier siehst du alles, was du auf dieser Stufe lernst, in einer Tabelle. Tippe auf eine Zeile, um sie zu hören. Lies die Tabelle immer wieder, damit du dir alles merkst."}},"en":{"stringUnit":{"state":"translated","value":"Here are all the facts of this level in one table. Tap a fact to hear it. Read the table again and again to remember the facts."}},"es":{"stringUnit":{"state":"needs_review","value":"Aquí tienes todos los datos de este nivel en una tabla. Toca un dato para escucharlo. Lee la tabla una y otra vez para recordar los datos."}},"fr":{"stringUnit":{"state":"needs_review","value":"Voici tous les faits de ce niveau dans un seul tableau. Touche un fait pour l’entendre. Relis le tableau encore et encore pour retenir les faits."}},"he":{"stringUnit":{"state":"needs_review","value":"כאן מופיעות כל העובדות של הרמה בטבלה אחת. הקישו על עובדה כדי לשמוע אותה. קראו את הטבלה שוב ושוב כדי לזכור את העובדות."}},"nl":{"stringUnit":{"state":"needs_review","value":"Hier staan alle rekenfeiten van dit niveau in één tabel. Tik op een rekenfeit om het te horen. Lees de tabel steeds opnieuw, zodat je de rekenfeiten onthoudt."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Aqui estão todos os fatos deste nível em uma tabela. Toque em um fato para ouvi-lo. Leia a tabela várias vezes para memorizar os fatos."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Aqui estão todos os factos deste nível numa tabela. Toca num facto para o ouvires. Lê a tabela várias vezes para memorizares os factos."}},"ru":{"stringUnit":{"state":"needs_review","value":"Здесь все примеры этого уровня собраны в одной таблице. Нажми на пример, чтобы его услышать. Читай таблицу снова и снова, чтобы запомнить примеры."}}}},
                    "Every card has a partner that is worth the same. Tap a card on one side, then tap its partner on the other side. Tap a card again to unselect it.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"እያንዳንዱ ካርድ እኩል ዋጋ ያለው ጥንድ አለው። በአንድ ወገን ያለን ካርድ ይንኩ፣ ከዚያም በሌላው ወገን ያለውን ጥንዱን ይንኩ። ምርጫውን ለመሰረዝ ካርዱን እንደገና ይንኩ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"لكل بطاقة شريكة تساويها في القيمة. اضغط على بطاقة في أحد الجانبين، ثم اضغط على شريكتها في الجانب الآخر. اضغط على البطاقة مرة أخرى لإلغاء اختيارها."}},"de":{"stringUnit":{"state":"needs_review","value":"Jede Karte hat eine Partnerkarte mit demselben Wert. Tippe auf eine Karte auf der einen Seite und dann auf ihre Partnerkarte auf der anderen Seite. Tippe noch einmal auf eine Karte, um die Auswahl aufzuheben."}},"en":{"stringUnit":{"state":"translated","value":"Every card has a partner that is worth the same. Tap a card on one side, then tap its partner on the other side. Tap a card again to unselect it."}},"es":{"stringUnit":{"state":"needs_review","value":"Cada tarjeta tiene una pareja que vale lo mismo. Toca una tarjeta de un lado y luego toca su pareja del otro lado. Vuelve a tocar una tarjeta para quitar la selección."}},"fr":{"stringUnit":{"state":"needs_review","value":"Chaque carte a une partenaire qui vaut la même chose. Touche une carte d’un côté, puis sa partenaire de l’autre côté. Touche à nouveau une carte pour la désélectionner."}},"he":{"stringUnit":{"state":"needs_review","value":"לכל כרטיס יש בן זוג ששווה לו. הקישו על כרטיס בצד אחד, ואז על בן הזוג שלו בצד השני. הקשה נוספת על כרטיס מבטלת את הבחירה."}},"nl":{"stringUnit":{"state":"needs_review","value":"Elke kaart heeft een maatje dat evenveel waard is. Tik op een kaart aan de ene kant en daarna op het maatje aan de andere kant. Tik nog een keer op een kaart om de keuze ongedaan te maken."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Cada cartão tem um par que vale o mesmo. Toque em um cartão de um lado e depois no par dele do outro lado. Toque de novo em um cartão para desmarcá-lo."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Cada cartão tem um par que vale o mesmo. Toca num cartão de um lado e depois no seu par do outro lado. Toca outra vez num cartão para o desmarcares."}},"ru":{"stringUnit":{"state":"needs_review","value":"У каждой карточки есть пара с таким же значением. Нажми на карточку с одной стороны, а потом — на её пару с другой стороны. Чтобы отменить выбор, нажми на карточку ещё раз."}}}},
                    "Look at the picture or the exercise at the top and find the answer. Tap a number card, or drag it, to put it in the answer box. For a bigger number, put its digits in order. Tap a number in the answer box to take it back. Then tap Check answer.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ከላይ ያለውን ምስል ወይም ስሌት ይመልከቱ እና መልሱን ያግኙ። የቁጥር ካርድን ወደ መልስ ሳጥኑ ለማስገባት ይንኩት ወይም ይጎትቱት። ለትልቅ ቁጥር አሃዞቹን በቅደም ተከተል ያስቀምጡ። በመልስ ሳጥኑ ውስጥ ያለን ቁጥር ለመመለስ ይንኩት። ከዚያም «መልሱን ያረጋግጡ» የሚለውን ይንኩ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"انظر إلى الصورة أو المسألة في الأعلى واعثر على الإجابة. اضغط على بطاقة عدد أو اسحبها لتضعها في مربع الإجابة. إذا كان العدد كبيرًا، فضع أرقامه بالترتيب. اضغط على عدد في مربع الإجابة لإرجاعه. ثم اضغط على «تحقق من الإجابة»."}},"de":{"stringUnit":{"state":"needs_review","value":"Schau dir das Bild oder die Aufgabe oben an und finde die Antwort. Tippe auf eine Zahlenkarte oder ziehe sie, um sie ins Antwortfeld zu legen. Bei einer größeren Zahl legst du ihre Ziffern der Reihe nach hinein. Tippe auf eine Zahl im Antwortfeld, um sie zurückzunehmen. Tippe dann auf „Antwort prüfen“."}},"en":{"stringUnit":{"state":"translated","value":"Look at the picture or the exercise at the top and find the answer. Tap a number card, or drag it, to put it in the answer box. For a bigger number, put its digits in order. Tap a number in the answer box to take it back. Then tap Check answer."}},"es":{"stringUnit":{"state":"needs_review","value":"Mira la imagen o la operación de arriba y encuentra la respuesta. Toca una tarjeta con un número, o arrástrala, para ponerla en el recuadro de respuesta. Si el número es más grande, pon sus dígitos en orden. Toca un número del recuadro de respuesta para quitarlo. Luego toca Comprobar respuesta."}},"fr":{"stringUnit":{"state":"needs_review","value":"Regarde l’image ou le calcul en haut et trouve la réponse. Touche une carte avec un nombre, ou fais-la glisser, pour la mettre dans la case réponse. Pour un nombre plus grand, place ses chiffres dans l’ordre. Touche un nombre dans la case réponse pour le retirer. Ensuite, touche « Vérifier la réponse »."}},"he":{"stringUnit":{"state":"needs_review","value":"הסתכלו על התמונה או על התרגיל שלמעלה ומצאו את התשובה. הקישו על כרטיס מספר, או גררו אותו, כדי לשים אותו בתיבת התשובה. במספר גדול יותר, שימו את הספרות שלו לפי הסדר. הקשה על מספר בתיבת התשובה מחזירה אותו. בסוף הקישו על ״בדיקת התשובה״."}},"nl":{"stringUnit":{"state":"needs_review","value":"Kijk naar de afbeelding of de som bovenaan en zoek het antwoord. Tik op een kaart met een getal of sleep hem, om hem in het antwoordvak te zetten. Bij een groter getal zet je de cijfers op volgorde. Tik op een getal in het antwoordvak om het terug te halen. Tik daarna op “Antwoord controleren”."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Olhe a imagem ou a conta lá em cima e descubra a resposta. Toque em um cartão com um número, ou arraste-o, para colocá-lo na caixa de resposta. Para um número maior, coloque os algarismos na ordem certa. Toque em um número na caixa de resposta para tirá-lo. Por fim, toque em “Conferir resposta”."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Olha para a imagem ou para a conta lá em cima e descobre a resposta. Toca num cartão com um número, ou arrasta-o, para o pores na caixa da resposta. Para um número maior, põe os algarismos pela ordem certa. Toca num número na caixa da resposta para o tirares. Por fim, toca em “Verificar resposta”."}},"ru":{"stringUnit":{"state":"needs_review","value":"Посмотри на картинку или пример наверху и найди ответ. Нажми на карточку с числом или перетащи её, чтобы положить в окошко для ответа. Для большого числа поставь его цифры по порядку. Чтобы убрать число из окошка для ответа, нажми на него. Потом нажми «Проверить ответ»."}}}},
                    "Look at the number or the exercise at the top. Tap the items below to add them to your group, one at a time, until your group has exactly that many. Tap an item in your group to take it out. Then press the green ✓ button.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ከላይ ያለውን ቁጥር ወይም ስሌት ይመልከቱ። ቡድንዎ ልክ ያን ያህል እስኪሆን ድረስ ከታች ያሉትን እቃዎች አንድ በአንድ እየነኩ ወደ ቡድንዎ ይጨምሩ። ከቡድንዎ ውስጥ አንድ እቃ ለማውጣት ይንኩት። ከዚያም አረንጓዴውን ✓ ቁልፍ ይጫኑ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"انظر إلى العدد أو المسألة في الأعلى. اضغط على العناصر في الأسفل لتضيفها إلى مجموعتك واحدًا تلو الآخر، حتى يصبح في مجموعتك العدد المطلوب تمامًا. اضغط على عنصر في مجموعتك لإخراجه. ثم اضغط على زر ✓ الأخضر."}},"de":{"stringUnit":{"state":"needs_review","value":"Schau dir die Zahl oder die Aufgabe oben an. Tippe nacheinander auf die Dinge unten, um sie zu deiner Gruppe hinzuzufügen, bis in deiner Gruppe genau so viele sind. Tippe auf ein Ding in deiner Gruppe, um es herauszunehmen. Drücke dann auf den grünen ✓-Knopf."}},"en":{"stringUnit":{"state":"translated","value":"Look at the number or the exercise at the top. Tap the items below to add them to your group, one at a time, until your group has exactly that many. Tap an item in your group to take it out. Then press the green ✓ button."}},"es":{"stringUnit":{"state":"needs_review","value":"Mira el número o la operación de arriba. Toca los objetos de abajo para añadirlos a tu grupo, de uno en uno, hasta que tu grupo tenga exactamente esa cantidad. Toca un objeto de tu grupo para sacarlo. Luego toca el botón verde ✓."}},"fr":{"stringUnit":{"state":"needs_review","value":"Regarde le nombre ou le calcul en haut. Touche les objets en bas pour les ajouter à ton groupe, un par un, jusqu’à ce que ton groupe en ait exactement autant. Touche un objet de ton groupe pour le retirer. Ensuite, appuie sur le bouton vert ✓."}},"he":{"stringUnit":{"state":"needs_review","value":"הסתכלו על המספר או על התרגיל שלמעלה. הקישו על הפריטים שלמטה כדי להוסיף אותם לקבוצה שלכם, אחד בכל פעם, עד שיהיו בה בדיוק כמה שצריך. הקשה על פריט בקבוצה מוציאה אותו. בסוף לחצו על כפתור ה־✓ הירוק."}},"nl":{"stringUnit":{"state":"needs_review","value":"Kijk naar het getal of de som bovenaan. Tik op de voorwerpen hieronder om ze één voor één aan je groepje toe te voegen, tot er precies zoveel in je groepje zitten. Tik op een voorwerp in je groepje om het eruit te halen. Druk daarna op de groene ✓-knop."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Olhe o número ou a conta lá em cima. Toque nos itens lá embaixo para adicioná-los ao seu grupo, um de cada vez, até o grupo ter exatamente essa quantidade. Toque em um item do seu grupo para tirá-lo. Por fim, aperte o botão verde ✓."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Olha para o número ou para a conta lá em cima. Toca nos itens lá em baixo para os juntares ao teu grupo, um de cada vez, até o grupo ter exatamente essa quantidade. Toca num item do teu grupo para o tirares. Por fim, carrega no botão verde ✓."}},"ru":{"stringUnit":{"state":"needs_review","value":"Посмотри на число или пример наверху. Нажимай на предметы внизу, чтобы добавлять их в свою группу по одному, пока в группе не станет ровно столько, сколько нужно. Чтобы убрать предмет из группы, нажми на него. Потом нажми зелёную кнопку ✓."}}}},
                    "Build the amount shown at the top with the pieces below. Tap a piece to add it to your build, and tap a piece in your build to take it out. Then press the green ✓ button.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ከላይ የሚታየውን መጠን ከታች ባሉት ክፍሎች ይገንቡ። አንድ ክፍል ወደ ገነቡት ለመጨመር ይንኩት፤ ከገነቡት ውስጥ ለማውጣት ደግሞ ክፍሉን ይንኩት። ከዚያም አረንጓዴውን ✓ ቁልፍ ይጫኑ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"كوّن الكمية الظاهرة في الأعلى باستخدام القطع في الأسفل. اضغط على قطعة لتضيفها إلى ما كوّنته، واضغط على قطعة فيما كوّنته لإخراجها. ثم اضغط على زر ✓ الأخضر."}},"de":{"stringUnit":{"state":"needs_review","value":"Baue die Menge, die oben gezeigt wird, mit den Teilen unten nach. Tippe auf ein Teil, um es zu deinem Bauwerk hinzuzufügen, und tippe auf ein Teil in deinem Bauwerk, um es herauszunehmen. Drücke dann auf den grünen ✓-Knopf."}},"en":{"stringUnit":{"state":"translated","value":"Build the amount shown at the top with the pieces below. Tap a piece to add it to your build, and tap a piece in your build to take it out. Then press the green ✓ button."}},"es":{"stringUnit":{"state":"needs_review","value":"Construye la cantidad que aparece arriba con las piezas de abajo. Toca una pieza para añadirla a tu construcción y toca una pieza de tu construcción para quitarla. Luego toca el botón verde ✓."}},"fr":{"stringUnit":{"state":"needs_review","value":"Construis la quantité affichée en haut avec les pièces en bas. Touche une pièce pour l’ajouter à ta construction, et touche une pièce de ta construction pour la retirer. Ensuite, appuie sur le bouton vert ✓."}},"he":{"stringUnit":{"state":"needs_review","value":"בעזרת החלקים שלמטה, בנו את הכמות שמופיעה למעלה. הקישו על חלק כדי להוסיף אותו, והקישו על חלק במה שבניתם כדי להוציא אותו. בסוף לחצו על כפתור ה־✓ הירוק."}},"nl":{"stringUnit":{"state":"needs_review","value":"Bouw met de stukjes hieronder de hoeveelheid die bovenaan staat. Tik op een stukje om het aan je bouwwerk toe te voegen, en tik op een stukje in je bouwwerk om het eruit te halen. Druk daarna op de groene ✓-knop."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Monte a quantidade mostrada lá em cima com as peças lá embaixo. Toque em uma peça para adicioná-la à sua montagem e toque em uma peça da sua montagem para tirá-la. Por fim, aperte o botão verde ✓."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Constrói a quantidade mostrada lá em cima com as peças lá em baixo. Toca numa peça para a juntares à tua construção e toca numa peça da tua construção para a tirares. Por fim, carrega no botão verde ✓."}},"ru":{"stringUnit":{"state":"needs_review","value":"Собери из частей внизу количество, показанное наверху. Нажми на часть, чтобы добавить её, а чтобы убрать часть из собранного, нажми на неё. Потом нажми зелёную кнопку ✓."}}}},
                    "Color the bar to show the amount at the top. Tap Add to color one more part and Undo to remove one. Then press the green ✓ button.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ከላይ ያለውን መጠን እንዲያሳይ አሞሌውን ቀለም ይቀቡ። አንድ ተጨማሪ ክፍል ለመቀባት «ጨምር»ን፣ አንዱን ለማስወገድ ደግሞ «ቀልብስ»ን ይንኩ። ከዚያም አረንጓዴውን ✓ ቁልፍ ይጫኑ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"لوّن الشريط ليُظهر الكمية الموجودة في الأعلى. اضغط على «إضافة» لتلوين جزء آخر، وعلى «تراجع» لإزالة جزء. ثم اضغط على زر ✓ الأخضر."}},"de":{"stringUnit":{"state":"needs_review","value":"Färbe den Balken so ein, dass er die Menge von oben zeigt. Tippe auf „Hinzufügen“, um einen weiteren Teil einzufärben, und auf „Rückgängig“, um einen zu entfernen. Drücke dann auf den grünen ✓-Knopf."}},"en":{"stringUnit":{"state":"translated","value":"Color the bar to show the amount at the top. Tap Add to color one more part and Undo to remove one. Then press the green ✓ button."}},"es":{"stringUnit":{"state":"needs_review","value":"Colorea la barra para mostrar la cantidad de arriba. Toca Añadir para colorear una parte más y Deshacer para quitar una. Luego toca el botón verde ✓."}},"fr":{"stringUnit":{"state":"needs_review","value":"Colorie la barre pour montrer la quantité affichée en haut. Touche « Ajouter » pour colorier une part de plus et « Annuler » pour en retirer une. Ensuite, appuie sur le bouton vert ✓."}},"he":{"stringUnit":{"state":"needs_review","value":"צבעו את הפס כך שיראה את הכמות שלמעלה. הקישו על ״הוספה״ כדי לצבוע עוד חלק ועל ״ביטול״ כדי להסיר חלק. בסוף לחצו על כפתור ה־✓ הירוק."}},"nl":{"stringUnit":{"state":"needs_review","value":"Kleur de balk zodat hij de hoeveelheid laat zien die bovenaan staat. Tik op “Toevoegen” om nog een deel te kleuren en op “Ongedaan maken” om er een weg te halen. Druk daarna op de groene ✓-knop."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Pinte a barra para mostrar a quantidade lá em cima. Toque em “Adicionar” para pintar mais uma parte e em “Desfazer” para tirar uma. Por fim, aperte o botão verde ✓."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Pinta a barra para mostrar a quantidade lá em cima. Toca em “Adicionar” para pintar mais uma parte e em “Anular” para tirar uma. Por fim, carrega no botão verde ✓."}},"ru":{"stringUnit":{"state":"needs_review","value":"Закрась полоску так, чтобы она показывала количество наверху. Нажми «Добавить», чтобы закрасить ещё одну часть, или «Отменить», чтобы убрать одну. Потом нажми зелёную кнопку ✓."}}}},
                    "Move the red dot along the number line with the arrow buttons until it stands on the number at the top. Then press the green ✓ button.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ቀዩ ነጥብ ከላይ ባለው ቁጥር ላይ እስኪቆም ድረስ በቀስት ቁልፎቹ በቁጥር መስመሩ ላይ ያንቀሳቅሱት። ከዚያም አረንጓዴውን ✓ ቁልፍ ይጫኑ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"حرّك النقطة الحمراء على خط الأعداد بأزرار الأسهم حتى تقف على العدد الموجود في الأعلى. ثم اضغط على زر ✓ الأخضر."}},"de":{"stringUnit":{"state":"needs_review","value":"Bewege den roten Punkt mit den Pfeiltasten auf dem Zahlenstrahl, bis er auf der Zahl von oben steht. Drücke dann auf den grünen ✓-Knopf."}},"en":{"stringUnit":{"state":"translated","value":"Move the red dot along the number line with the arrow buttons until it stands on the number at the top. Then press the green ✓ button."}},"es":{"stringUnit":{"state":"needs_review","value":"Mueve el punto rojo por la recta numérica con los botones de flecha hasta que quede sobre el número de arriba. Luego toca el botón verde ✓."}},"fr":{"stringUnit":{"state":"needs_review","value":"Déplace le point rouge sur la droite graduée avec les boutons fléchés, jusqu’à ce qu’il soit sur le nombre affiché en haut. Ensuite, appuie sur le bouton vert ✓."}},"he":{"stringUnit":{"state":"needs_review","value":"הזיזו את הנקודה האדומה על ישר המספרים בעזרת כפתורי החצים, עד שהיא עומדת על המספר שלמעלה. בסוף לחצו על כפתור ה־✓ הירוק."}},"nl":{"stringUnit":{"state":"needs_review","value":"Verschuif de rode stip met de pijlknoppen over de getallenlijn, tot hij op hetzelfde getal staat als bovenaan. Druk daarna op de groene ✓-knop."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Mova o ponto vermelho pela reta numérica com os botões de seta até ele chegar ao número mostrado lá em cima. Por fim, aperte o botão verde ✓."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Move o ponto vermelho ao longo da reta numérica com os botões das setas até ele chegar ao número mostrado lá em cima. Por fim, carrega no botão verde ✓."}},"ru":{"stringUnit":{"state":"needs_review","value":"Двигай красную точку по числовой прямой кнопками со стрелками, пока она не окажется на числе, которое показано наверху. Потом нажми зелёную кнопку ✓."}}}},
                    "Look at the picture or the exercise at the top. Count or solve, then tap the card with the right answer.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ከላይ ያለውን ምስል ወይም ስሌት ይመልከቱ። ይቁጠሩ ወይም ይፍቱ፣ ከዚያም ትክክለኛው መልስ ያለበትን ካርድ ይንኩ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"انظر إلى الصورة أو المسألة في الأعلى. عُدّ أو حُلّ، ثم اضغط على البطاقة التي عليها الإجابة الصحيحة."}},"de":{"stringUnit":{"state":"needs_review","value":"Schau dir das Bild oder die Aufgabe oben an. Zähle oder rechne und tippe dann auf die Karte mit der richtigen Antwort."}},"en":{"stringUnit":{"state":"translated","value":"Look at the picture or the exercise at the top. Count or solve, then tap the card with the right answer."}},"es":{"stringUnit":{"state":"needs_review","value":"Mira la imagen o la operación de arriba. Cuenta o resuelve y luego toca la tarjeta con la respuesta correcta."}},"fr":{"stringUnit":{"state":"needs_review","value":"Regarde l’image ou le calcul en haut. Compte ou calcule, puis touche la carte avec la bonne réponse."}},"he":{"stringUnit":{"state":"needs_review","value":"הסתכלו על התמונה או על התרגיל שלמעלה. ספרו או פתרו, ואז הקישו על הכרטיס עם התשובה הנכונה."}},"nl":{"stringUnit":{"state":"needs_review","value":"Kijk naar de afbeelding of de som bovenaan. Tel of reken uit, en tik dan op de kaart met het juiste antwoord."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Olhe a imagem ou a conta lá em cima. Conte ou resolva e depois toque no cartão com a resposta certa."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Olha para a imagem ou para a conta lá em cima. Conta ou resolve e depois toca no cartão com a resposta certa."}},"ru":{"stringUnit":{"state":"needs_review","value":"Посмотри на картинку или пример наверху. Посчитай или реши, а потом нажми на карточку с правильным ответом."}}}},
                    "Look at the number at the top. Then tap the picture or the exercise that is worth exactly the same.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ከላይ ያለውን ቁጥር ይመልከቱ። ከዚያም ልክ ተመሳሳይ ዋጋ ያለውን ምስል ወይም ስሌት ይንኩ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"انظر إلى العدد في الأعلى. ثم اضغط على الصورة أو المسألة التي تساويه تمامًا."}},"de":{"stringUnit":{"state":"needs_review","value":"Schau dir die Zahl oben an. Tippe dann auf das Bild oder die Aufgabe mit genau demselben Wert."}},"en":{"stringUnit":{"state":"translated","value":"Look at the number at the top. Then tap the picture or the exercise that is worth exactly the same."}},"es":{"stringUnit":{"state":"needs_review","value":"Mira el número de arriba. Luego toca la imagen o la operación que vale exactamente lo mismo."}},"fr":{"stringUnit":{"state":"needs_review","value":"Regarde le nombre en haut. Ensuite, touche l’image ou le calcul qui vaut exactement autant."}},"he":{"stringUnit":{"state":"needs_review","value":"הסתכלו על המספר שלמעלה. אחר כך הקישו על התמונה או על התרגיל ששווה לו בדיוק."}},"nl":{"stringUnit":{"state":"needs_review","value":"Kijk naar het getal bovenaan. Tik dan op de afbeelding of de som die precies evenveel waard is."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Olhe o número lá em cima. Depois toque na imagem ou na conta que vale exatamente o mesmo."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Olha para o número lá em cima. Depois toca na imagem ou na conta que vale exatamente o mesmo."}},"ru":{"stringUnit":{"state":"needs_review","value":"Посмотри на число наверху. Потом нажми на картинку или пример с точно таким же значением."}}}},
                    "Count the pictures at the top. Tap the numbers in order, 1, 2, 3…, until every picture is counted. Tap a number in your answer to take it back. Then tap Check answer.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ከላይ ያሉትን ምስሎች ይቁጠሩ። ሁሉም ምስሎች እስኪቆጠሩ ድረስ ቁጥሮቹን በቅደም ተከተል፣ 1፣ 2፣ 3…፣ ይንኩ። በመልስዎ ውስጥ ያለን ቁጥር ለመመለስ ይንኩት። ከዚያም «መልሱን ያረጋግጡ» የሚለውን ይንኩ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"عُدّ الصور في الأعلى. اضغط على الأعداد بالترتيب، 1، 2، 3…، حتى تعدّ كل الصور. اضغط على عدد في إجابتك لإرجاعه. ثم اضغط على «تحقق من الإجابة»."}},"de":{"stringUnit":{"state":"needs_review","value":"Zähle die Bilder oben. Tippe die Zahlen der Reihe nach an, 1, 2, 3 …, bis alle Bilder gezählt sind. Tippe auf eine Zahl in deiner Antwort, um sie zurückzunehmen. Tippe dann auf „Antwort prüfen“."}},"en":{"stringUnit":{"state":"translated","value":"Count the pictures at the top. Tap the numbers in order, 1, 2, 3…, until every picture is counted. Tap a number in your answer to take it back. Then tap Check answer."}},"es":{"stringUnit":{"state":"needs_review","value":"Cuenta las imágenes de arriba. Toca los números en orden, 1, 2, 3…, hasta contar todas las imágenes. Toca un número de tu respuesta para quitarlo. Luego toca Comprobar respuesta."}},"fr":{"stringUnit":{"state":"needs_review","value":"Compte les images en haut. Touche les nombres dans l’ordre, 1, 2, 3…, jusqu’à avoir compté toutes les images. Touche un nombre de ta réponse pour le retirer. Ensuite, touche « Vérifier la réponse »."}},"he":{"stringUnit":{"state":"needs_review","value":"ספרו את התמונות שלמעלה. הקישו על המספרים לפי הסדר, 1, 2, 3…, עד שתספרו את כל התמונות. הקשה על מספר בתשובה מחזירה אותו. בסוף הקישו על ״בדיקת התשובה״."}},"nl":{"stringUnit":{"state":"needs_review","value":"Tel de afbeeldingen bovenaan. Tik op volgorde op de getallen, 1, 2, 3…, tot je alle afbeeldingen hebt geteld. Tik op een getal in je antwoord om het terug te halen. Tik daarna op “Antwoord controleren”."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Conte as imagens lá em cima. Toque nos números em ordem, 1, 2, 3…, até contar todas as imagens. Toque em um número da sua resposta para tirá-lo. Por fim, toque em “Conferir resposta”."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Conta as imagens lá em cima. Toca nos números por ordem, 1, 2, 3…, até contares todas as imagens. Toca num número da tua resposta para o tirares. Por fim, toca em “Verificar resposta”."}},"ru":{"stringUnit":{"state":"needs_review","value":"Посчитай картинки наверху. Нажимай на числа по порядку — 1, 2, 3… — пока не посчитаешь все картинки. Чтобы убрать число из ответа, нажми на него. Потом нажми «Проверить ответ»."}}}},
                    "Build the whole exercise from the pieces: tap them in the right order. One piece is extra. Tap a piece in your answer to take it back. Then tap Check answer.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ሙሉውን ስሌት ከክፍሎቹ ይገንቡ፦ በትክክለኛው ቅደም ተከተል ይንኳቸው። አንዱ ክፍል ትርፍ ነው። በመልስዎ ውስጥ ያለን ክፍል ለመመለስ ይንኩት። ከዚያም «መልሱን ያረጋግጡ» የሚለውን ይንኩ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"كوّن المسألة كاملة من القطع: اضغط عليها بالترتيب الصحيح. إحدى القطع زائدة. اضغط على قطعة في إجابتك لإرجاعها. ثم اضغط على «تحقق من الإجابة»."}},"de":{"stringUnit":{"state":"needs_review","value":"Baue die ganze Aufgabe aus den Teilen: Tippe sie in der richtigen Reihenfolge an. Ein Teil ist zu viel. Tippe auf ein Teil in deiner Antwort, um es zurückzunehmen. Tippe dann auf „Antwort prüfen“."}},"en":{"stringUnit":{"state":"translated","value":"Build the whole exercise from the pieces: tap them in the right order. One piece is extra. Tap a piece in your answer to take it back. Then tap Check answer."}},"es":{"stringUnit":{"state":"needs_review","value":"Construye toda la operación con las piezas: tócalas en el orden correcto. Sobra una pieza. Toca una pieza de tu respuesta para quitarla. Luego toca Comprobar respuesta."}},"fr":{"stringUnit":{"state":"needs_review","value":"Construis tout le calcul avec les pièces : touche-les dans le bon ordre. Une pièce est en trop. Touche une pièce de ta réponse pour la retirer. Ensuite, touche « Vérifier la réponse »."}},"he":{"stringUnit":{"state":"needs_review","value":"בנו את התרגיל כולו מהחלקים: הקישו עליהם לפי הסדר הנכון. חלק אחד מיותר. הקשה על חלק בתשובה מחזירה אותו. בסוף הקישו על ״בדיקת התשובה״."}},"nl":{"stringUnit":{"state":"needs_review","value":"Bouw de hele som met de stukjes: tik ze in de juiste volgorde aan. Eén stukje hoort er niet bij. Tik op een stukje in je antwoord om het terug te halen. Tik daarna op “Antwoord controleren”."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Monte a conta inteira com as peças: toque nelas na ordem certa. Uma peça está sobrando. Toque em uma peça da sua resposta para tirá-la. Por fim, toque em “Conferir resposta”."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Constrói a conta inteira com as peças: toca nelas pela ordem certa. Há uma peça a mais. Toca numa peça da tua resposta para a tirares. Por fim, toca em “Verificar resposta”."}},"ru":{"stringUnit":{"state":"needs_review","value":"Составь весь пример из частей: нажимай на них в правильном порядке. Одна часть лишняя. Чтобы убрать часть из ответа, нажми на неё. Потом нажми «Проверить ответ»."}}}},
                    "Build a tower with exactly as many blocks as the number at the top, or as the answer to the exercise at the top. Tap a block to add it, and tap a block in your tower to take it off. Then press the green ✓ button.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ከላይ ባለው ቁጥር ወይም ከላይ ባለው ስሌት መልስ ልክ ያህል ብሎኮች ያሉት ማማ ይገንቡ። ብሎክ ለመጨመር ይንኩት፤ ከማማዎ ላይ ለማንሳት ደግሞ በማማዎ ውስጥ ያለን ብሎክ ይንኩ። ከዚያም አረንጓዴውን ✓ ቁልፍ ይጫኑ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"ابنِ برجًا عدد مكعباته يساوي تمامًا العدد الموجود في الأعلى، أو إجابة المسألة الموجودة في الأعلى. اضغط على مكعب لإضافته، واضغط على مكعب في برجك لإزالته. ثم اضغط على زر ✓ الأخضر."}},"de":{"stringUnit":{"state":"needs_review","value":"Baue einen Turm mit genau so vielen Bausteinen wie die Zahl oben – oder wie das Ergebnis der Aufgabe oben. Tippe auf einen Baustein, um ihn hinzuzufügen, und tippe auf einen Baustein in deinem Turm, um ihn wegzunehmen. Drücke dann auf den grünen ✓-Knopf."}},"en":{"stringUnit":{"state":"translated","value":"Build a tower with exactly as many blocks as the number at the top, or as the answer to the exercise at the top. Tap a block to add it, and tap a block in your tower to take it off. Then press the green ✓ button."}},"es":{"stringUnit":{"state":"needs_review","value":"Construye una torre con exactamente tantos bloques como el número de arriba, o como la respuesta a la operación de arriba. Toca un bloque para añadirlo y toca un bloque de tu torre para quitarlo. Luego toca el botón verde ✓."}},"fr":{"stringUnit":{"state":"needs_review","value":"Construis une tour avec exactement autant de blocs que le nombre en haut, ou que la réponse au calcul en haut. Touche un bloc pour l’ajouter, et touche un bloc de ta tour pour l’enlever. Ensuite, appuie sur le bouton vert ✓."}},"he":{"stringUnit":{"state":"needs_review","value":"בנו מגדל עם מספר קוביות ששווה בדיוק למספר שלמעלה, או לתשובה של התרגיל שלמעלה. הקישו על קובייה כדי להוסיף אותה, והקישו על קובייה במגדל כדי להוריד אותה. בסוף לחצו על כפתור ה־✓ הירוק."}},"nl":{"stringUnit":{"state":"needs_review","value":"Bouw een toren met precies zoveel blokken als het getal bovenaan, of als het antwoord op de som bovenaan. Tik op een blok om het toe te voegen en tik op een blok in je toren om het eraf te halen. Druk daarna op de groene ✓-knop."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Monte uma torre com exatamente tantos blocos quanto o número lá em cima, ou quanto a resposta da conta lá em cima. Toque em um bloco para adicioná-lo e toque em um bloco da sua torre para tirá-lo. Por fim, aperte o botão verde ✓."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Constrói uma torre com exatamente tantos blocos como o número lá em cima, ou como a resposta à conta lá em cima. Toca num bloco para o adicionares e toca num bloco da tua torre para o tirares. Por fim, carrega no botão verde ✓."}},"ru":{"stringUnit":{"state":"needs_review","value":"Построй башню ровно из стольких блоков, сколько показывает число наверху или сколько получается в примере наверху. Нажми на блок, чтобы добавить его, а чтобы снять блок с башни, нажми на него. Потом нажми зелёную кнопку ✓."}}}},
                    "Each block has a piece of the answer. Tap the blocks in the right order to build the answer. Tap a block in your answer to take it back. Then press the green ✓ button.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"እያንዳንዱ ብሎክ የመልሱ አንድ ክፍል አለው። መልሱን ለመገንባት ብሎኮቹን በትክክለኛው ቅደም ተከተል ይንኩ። በመልስዎ ውስጥ ያለን ብሎክ ለመመለስ ይንኩት። ከዚያም አረንጓዴውን ✓ ቁልፍ ይጫኑ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"على كل مكعب جزء من الإجابة. اضغط على المكعبات بالترتيب الصحيح لتكوّن الإجابة. اضغط على مكعب في إجابتك لإرجاعه. ثم اضغط على زر ✓ الأخضر."}},"de":{"stringUnit":{"state":"needs_review","value":"Auf jedem Baustein steht ein Teil der Antwort. Tippe die Bausteine in der richtigen Reihenfolge an, um die Antwort zu bauen. Tippe auf einen Baustein in deiner Antwort, um ihn zurückzunehmen. Drücke dann auf den grünen ✓-Knopf."}},"en":{"stringUnit":{"state":"translated","value":"Each block has a piece of the answer. Tap the blocks in the right order to build the answer. Tap a block in your answer to take it back. Then press the green ✓ button."}},"es":{"stringUnit":{"state":"needs_review","value":"Cada bloque tiene una parte de la respuesta. Toca los bloques en el orden correcto para construir la respuesta. Toca un bloque de tu respuesta para quitarlo. Luego toca el botón verde ✓."}},"fr":{"stringUnit":{"state":"needs_review","value":"Chaque bloc porte une partie de la réponse. Touche les blocs dans le bon ordre pour construire la réponse. Touche un bloc de ta réponse pour le retirer. Ensuite, appuie sur le bouton vert ✓."}},"he":{"stringUnit":{"state":"needs_review","value":"על כל קובייה יש חלק מהתשובה. הקישו על הקוביות לפי הסדר הנכון כדי לבנות את התשובה. הקשה על קובייה בתשובה מחזירה אותה. בסוף לחצו על כפתור ה־✓ הירוק."}},"nl":{"stringUnit":{"state":"needs_review","value":"Op elk blok staat een stukje van het antwoord. Tik in de juiste volgorde op de blokken om het antwoord te bouwen. Tik op een blok in je antwoord om het terug te halen. Druk daarna op de groene ✓-knop."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Cada bloco tem uma parte da resposta. Toque nos blocos na ordem certa para montar a resposta. Toque em um bloco da sua resposta para tirá-lo. Por fim, aperte o botão verde ✓."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Cada bloco tem uma parte da resposta. Toca nos blocos pela ordem certa para construíres a resposta. Toca num bloco da tua resposta para o tirares. Por fim, carrega no botão verde ✓."}},"ru":{"stringUnit":{"state":"needs_review","value":"На каждом блоке — часть ответа. Нажимай на блоки в правильном порядке, чтобы составить ответ. Чтобы убрать блок из ответа, нажми на него. Потом нажми зелёную кнопку ✓."}}}},
                    "All the cards are face down. Tap two cards to turn them over. If they are worth the same, they stay open. Find all the pairs!": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ሁሉም ካርዶች ፊታቸው ወደ ታች ነው። ለመገልበጥ ሁለት ካርዶችን ይንኩ። እኩል ዋጋ ካላቸው ክፍት ሆነው ይቆያሉ። ሁሉንም ጥንዶች ያግኙ!"}},"ar":{"stringUnit":{"state":"needs_review","value":"كل البطاقات مقلوبة. اضغط على بطاقتين لتقلبهما. إذا كانت قيمتهما متساوية، تبقيان مكشوفتين. اعثر على كل الأزواج!"}},"de":{"stringUnit":{"state":"needs_review","value":"Alle Karten liegen verdeckt. Tippe auf zwei Karten, um sie umzudrehen. Wenn sie denselben Wert haben, bleiben sie offen liegen. Finde alle Paare!"}},"en":{"stringUnit":{"state":"translated","value":"All the cards are face down. Tap two cards to turn them over. If they are worth the same, they stay open. Find all the pairs!"}},"es":{"stringUnit":{"state":"needs_review","value":"Todas las cartas están boca abajo. Toca dos cartas para voltearlas. Si valen lo mismo, se quedan boca arriba. ¡Encuentra todas las parejas!"}},"fr":{"stringUnit":{"state":"needs_review","value":"Toutes les cartes sont face cachée. Touche deux cartes pour les retourner. Si elles valent la même chose, elles restent visibles. Trouve toutes les paires !"}},"he":{"stringUnit":{"state":"needs_review","value":"כל הקלפים הפוכים. הקישו על שני קלפים כדי להפוך אותם. אם הם שווים זה לזה, הם נשארים פתוחים. מצאו את כל הזוגות!"}},"nl":{"stringUnit":{"state":"needs_review","value":"Alle kaarten liggen omgekeerd. Tik op twee kaarten om ze om te draaien. Zijn ze evenveel waard, dan blijven ze open liggen. Zoek alle paren!"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Todas as cartas estão viradas para baixo. Toque em duas cartas para virá-las. Se elas valerem o mesmo, ficam abertas. Encontre todos os pares!"}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Todas as cartas estão viradas para baixo. Toca em duas cartas para as virares. Se valerem o mesmo, ficam abertas. Encontra todos os pares!"}},"ru":{"stringUnit":{"state":"needs_review","value":"Все карточки лежат рубашкой вверх. Нажми на две карточки, чтобы перевернуть их. Если у них одинаковое значение, они остаются открытыми. Найди все пары!"}}}},
                    "Your answer": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"መልስዎ"}},"ar":{"stringUnit":{"state":"needs_review","value":"إجابتك"}},"de":{"stringUnit":{"state":"needs_review","value":"Deine Antwort"}},"en":{"stringUnit":{"state":"translated","value":"Your answer"}},"es":{"stringUnit":{"state":"needs_review","value":"Tu respuesta"}},"fr":{"stringUnit":{"state":"needs_review","value":"Ta réponse"}},"he":{"stringUnit":{"state":"needs_review","value":"התשובה שלכם"}},"nl":{"stringUnit":{"state":"needs_review","value":"Jouw antwoord"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Sua resposta"}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"A tua resposta"}},"ru":{"stringUnit":{"state":"needs_review","value":"Твой ответ"}}}},
                    "Takes this piece back out of your answer": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ይህን ክፍል ከመልስዎ ያስወጣል"}},"ar":{"stringUnit":{"state":"needs_review","value":"يُخرج هذه القطعة من إجابتك"}},"de":{"stringUnit":{"state":"needs_review","value":"Nimmt dieses Teil wieder aus deiner Antwort heraus"}},"en":{"stringUnit":{"state":"translated","value":"Takes this piece back out of your answer"}},"es":{"stringUnit":{"state":"needs_review","value":"Quita esta pieza de tu respuesta"}},"fr":{"stringUnit":{"state":"needs_review","value":"Retire cette pièce de ta réponse"}},"he":{"stringUnit":{"state":"needs_review","value":"מוציא את החלק הזה מהתשובה"}},"nl":{"stringUnit":{"state":"needs_review","value":"Haalt dit stukje weer uit je antwoord"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Tira esta peça da sua resposta"}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Tira esta peça da tua resposta"}},"ru":{"stringUnit":{"state":"needs_review","value":"Убирает эту часть из ответа"}}}},
                    "That's too many. Tap one in your answer to take it back.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"በጣም ብዙ ነው። አንዱን ለማውጣት በመልስዎ ውስጥ ይንኩት።"}},"ar":{"stringUnit":{"state":"needs_review","value":"هذا أكثر من اللازم. اضغط على أحدها في إجابتك لإرجاعه."}},"de":{"stringUnit":{"state":"needs_review","value":"Das sind zu viele. Tippe in deiner Antwort auf eins, um es zurückzunehmen."}},"en":{"stringUnit":{"state":"translated","value":"That's too many. Tap one in your answer to take it back."}},"es":{"stringUnit":{"state":"needs_review","value":"Hay demasiados. Toca uno de tu respuesta para quitarlo."}},"fr":{"stringUnit":{"state":"needs_review","value":"Il y en a trop. Touche un élément de ta réponse pour le retirer."}},"he":{"stringUnit":{"state":"needs_review","value":"יש יותר מדי. הקישו על אחד מהם בתשובה כדי להוציא אותו."}},"nl":{"stringUnit":{"state":"needs_review","value":"Dat zijn er te veel. Tik op een stukje in je antwoord om het terug te halen."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"São peças demais. Toque em uma delas na sua resposta para tirá-la."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Há peças a mais. Toca numa delas na tua resposta para a tirares."}},"ru":{"stringUnit":{"state":"needs_review","value":"Слишком много. Нажми на любую часть ответа, чтобы убрать её."}}}},
                    "Tap the blocks in order to build the answer.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"መልሱን ለመገንባት ብሎኮቹን በቅደም ተከተል ይንኩ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"اضغط على المكعبات بالترتيب لتكوّن الإجابة."}},"de":{"stringUnit":{"state":"needs_review","value":"Tippe die Bausteine der Reihe nach an, um die Antwort zu bauen."}},"en":{"stringUnit":{"state":"translated","value":"Tap the blocks in order to build the answer."}},"es":{"stringUnit":{"state":"needs_review","value":"Toca los bloques en orden para construir la respuesta."}},"fr":{"stringUnit":{"state":"needs_review","value":"Touche les blocs dans l’ordre pour construire la réponse."}},"he":{"stringUnit":{"state":"needs_review","value":"הקישו על הקוביות לפי הסדר כדי לבנות את התשובה."}},"nl":{"stringUnit":{"state":"needs_review","value":"Tik op volgorde op de blokken om het antwoord te bouwen."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Toque nos blocos na ordem certa para montar a resposta."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Toca nos blocos pela ordem certa para construíres a resposta."}},"ru":{"stringUnit":{"state":"needs_review","value":"Нажимай на блоки по порядку, чтобы составить ответ."}}}},
                    "Count the pictures, then tap or drag the matching number into the answer box.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ምስሎቹን ይቁጠሩ፣ ከዚያም ተዛማጁን ቁጥር ይንኩ ወይም ወደ መልስ ሳጥኑ ይጎትቱ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"عُدّ الصور، ثم اضغط على العدد المطابق أو اسحبه إلى مربع الإجابة."}},"de":{"stringUnit":{"state":"needs_review","value":"Zähle die Bilder und tippe dann die passende Zahl an oder ziehe sie ins Antwortfeld."}},"en":{"stringUnit":{"state":"translated","value":"Count the pictures, then tap or drag the matching number into the answer box."}},"es":{"stringUnit":{"state":"needs_review","value":"Cuenta las imágenes y luego toca el número que corresponde o arrástralo al recuadro de respuesta."}},"fr":{"stringUnit":{"state":"needs_review","value":"Compte les images, puis touche le bon nombre ou fais-le glisser dans la case réponse."}},"he":{"stringUnit":{"state":"needs_review","value":"ספרו את התמונות, ואז הקישו על המספר המתאים או גררו אותו לתיבת התשובה."}},"nl":{"stringUnit":{"state":"needs_review","value":"Tel de afbeeldingen en tik op het getal dat past, of sleep het naar het antwoordvak."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Conte as imagens e depois toque no número certo ou arraste-o até a caixa de resposta."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Conta as imagens e depois toca no número certo ou arrasta-o para a caixa da resposta."}},"ru":{"stringUnit":{"state":"needs_review","value":"Посчитай картинки, а потом нажми на нужное число или перетащи его в окошко для ответа."}}}},
                    "Solve the exercise, then tap or drag the answer into the answer box.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ስሌቱን ይፍቱ፣ ከዚያም መልሱን ይንኩ ወይም ወደ መልስ ሳጥኑ ይጎትቱ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"حُلّ المسألة، ثم اضغط على الإجابة أو اسحبها إلى مربع الإجابة."}},"de":{"stringUnit":{"state":"needs_review","value":"Löse die Aufgabe und tippe dann die Antwort an oder ziehe sie ins Antwortfeld."}},"en":{"stringUnit":{"state":"translated","value":"Solve the exercise, then tap or drag the answer into the answer box."}},"es":{"stringUnit":{"state":"needs_review","value":"Resuelve la operación y luego toca la respuesta o arrástrala al recuadro de respuesta."}},"fr":{"stringUnit":{"state":"needs_review","value":"Fais le calcul, puis touche la réponse ou fais-la glisser dans la case réponse."}},"he":{"stringUnit":{"state":"needs_review","value":"פתרו את התרגיל, ואז הקישו על התשובה או גררו אותה לתיבת התשובה."}},"nl":{"stringUnit":{"state":"needs_review","value":"Reken de som uit en tik op het antwoord, of sleep het naar het antwoordvak."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Resolva a conta e depois toque na resposta ou arraste-a até a caixa de resposta."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Resolve a conta e depois toca na resposta ou arrasta-a para a caixa da resposta."}},"ru":{"stringUnit":{"state":"needs_review","value":"Реши пример, а потом нажми на ответ или перетащи его в окошко для ответа."}}}},
                    "Find the answer, then tap or drag its digits into the answer box, in order.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"መልሱን ያግኙ፣ ከዚያም አሃዞቹን በቅደም ተከተል ይንኩ ወይም ወደ መልስ ሳጥኑ ይጎትቱ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"اعثر على الإجابة، ثم اضغط على أرقامها أو اسحبها إلى مربع الإجابة بالترتيب."}},"de":{"stringUnit":{"state":"needs_review","value":"Finde die Antwort und bringe dann ihre Ziffern der Reihe nach ins Antwortfeld – durch Tippen oder Ziehen."}},"en":{"stringUnit":{"state":"translated","value":"Find the answer, then tap or drag its digits into the answer box, in order."}},"es":{"stringUnit":{"state":"needs_review","value":"Encuentra la respuesta y luego toca sus dígitos o arrástralos al recuadro de respuesta, en orden."}},"fr":{"stringUnit":{"state":"needs_review","value":"Trouve la réponse, puis touche ses chiffres ou fais-les glisser dans la case réponse, dans l’ordre."}},"he":{"stringUnit":{"state":"needs_review","value":"מצאו את התשובה, ואז הקישו על הספרות שלה או גררו אותן לתיבת התשובה, לפי הסדר."}},"nl":{"stringUnit":{"state":"needs_review","value":"Zoek het antwoord en zet de cijfers op volgorde in het antwoordvak: tik erop of sleep ze."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Descubra a resposta e depois toque nos algarismos dela ou arraste-os até a caixa de resposta, na ordem certa."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Descobre a resposta e depois toca nos seus algarismos ou arrasta-os para a caixa da resposta, pela ordem certa."}},"ru":{"stringUnit":{"state":"needs_review","value":"Найди ответ, а потом по порядку нажми на его цифры или перетащи их в окошко для ответа."}}}},
                    "Count the pictures: tap the numbers in order, 1, 2, 3…, until every picture is counted.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ምስሎቹን ይቁጠሩ፦ ሁሉም ምስሎች እስኪቆጠሩ ድረስ ቁጥሮቹን በቅደም ተከተል፣ 1፣ 2፣ 3…፣ ይንኩ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"عُدّ الصور: اضغط على الأعداد بالترتيب، 1، 2، 3…، حتى تعدّ كل الصور."}},"de":{"stringUnit":{"state":"needs_review","value":"Zähle die Bilder: Tippe die Zahlen der Reihe nach an, 1, 2, 3 …, bis alle Bilder gezählt sind."}},"en":{"stringUnit":{"state":"translated","value":"Count the pictures: tap the numbers in order, 1, 2, 3…, until every picture is counted."}},"es":{"stringUnit":{"state":"needs_review","value":"Cuenta las imágenes: toca los números en orden, 1, 2, 3…, hasta contar todas las imágenes."}},"fr":{"stringUnit":{"state":"needs_review","value":"Compte les images : touche les nombres dans l’ordre, 1, 2, 3…, jusqu’à avoir compté toutes les images."}},"he":{"stringUnit":{"state":"needs_review","value":"ספרו את התמונות: הקישו על המספרים לפי הסדר, 1, 2, 3…, עד שתספרו את כל התמונות."}},"nl":{"stringUnit":{"state":"needs_review","value":"Tel de afbeeldingen: tik op volgorde op de getallen, 1, 2, 3…, tot je alle afbeeldingen hebt geteld."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Conte as imagens: toque nos números em ordem, 1, 2, 3…, até contar todas as imagens."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Conta as imagens: toca nos números por ordem, 1, 2, 3…, até contares todas as imagens."}},"ru":{"stringUnit":{"state":"needs_review","value":"Посчитай картинки: нажимай на числа по порядку — 1, 2, 3… — пока не посчитаешь все картинки."}}}},
                    "Build the whole exercise: tap the pieces in the right order. One piece is extra.": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ሙሉውን ስሌት ይገንቡ፦ ክፍሎቹን በትክክለኛው ቅደም ተከተል ይንኩ። አንዱ ክፍል ትርፍ ነው።"}},"ar":{"stringUnit":{"state":"needs_review","value":"كوّن المسألة كاملة: اضغط على القطع بالترتيب الصحيح. إحدى القطع زائدة."}},"de":{"stringUnit":{"state":"needs_review","value":"Baue die ganze Aufgabe: Tippe die Teile in der richtigen Reihenfolge an. Ein Teil ist zu viel."}},"en":{"stringUnit":{"state":"translated","value":"Build the whole exercise: tap the pieces in the right order. One piece is extra."}},"es":{"stringUnit":{"state":"needs_review","value":"Construye toda la operación: toca las piezas en el orden correcto. Sobra una pieza."}},"fr":{"stringUnit":{"state":"needs_review","value":"Construis tout le calcul : touche les pièces dans le bon ordre. Une pièce est en trop."}},"he":{"stringUnit":{"state":"needs_review","value":"בנו את התרגיל כולו: הקישו על החלקים לפי הסדר הנכון. חלק אחד מיותר."}},"nl":{"stringUnit":{"state":"needs_review","value":"Bouw de hele som: tik in de juiste volgorde op de stukjes. Eén stukje hoort er niet bij."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Monte a conta inteira: toque nas peças na ordem certa. Uma peça está sobrando."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Constrói a conta inteira: toca nas peças pela ordem certa. Há uma peça a mais."}},"ru":{"stringUnit":{"state":"needs_review","value":"Составь весь пример: нажимай на части в правильном порядке. Одна часть лишняя."}}}},
