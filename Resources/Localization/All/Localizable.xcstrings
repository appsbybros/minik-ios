                    "Selects the look of the game": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"translated","value":"የጨዋታውን ገጽታ ይመርጣል"}},"ar":{"stringUnit":{"state":"translated","value":"يختار مظهر اللعبة"}},"de":{"stringUnit":{"state":"translated","value":"Wählt das Aussehen des Spiels"}},"en":{"stringUnit":{"state":"translated","value":"Selects the look of the game"}},"es":{"stringUnit":{"state":"translated","value":"Elige el aspecto del juego"}},"fr":{"stringUnit":{"state":"translated","value":"Choisit l’apparence du jeu"}},"he":{"stringUnit":{"state":"translated","value":"בוחר את מראה המשחק"}},"nl":{"stringUnit":{"state":"translated","value":"Kiest het uiterlijk van het spel"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolhe a aparência do jogo"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Escolhe o aspeto do jogo"}},"ru":{"stringUnit":{"state":"translated","value":"Выбирает внешний вид игры"}}}},
                    "A best score is waiting to publish.": {"extractionState":"manual","comment":"iOS release integration; non-English fallback requires linguistic review.","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ይፋ ለመሆን የሚጠብቅ ምርጥ ውጤት አለ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"رقم قياسي في النقاط بانتظار النشر."}},"de":{"stringUnit":{"state":"needs_review","value":"Eine Bestleistung wartet auf die Veröffentlichung."}},"en":{"stringUnit":{"state":"translated","value":"A best score is waiting to publish."}},"es":{"stringUnit":{"state":"needs_review","value":"Hay una puntuación récord pendiente de publicar."}},"fr":{"stringUnit":{"state":"needs_review","value":"Un meilleur score attend d’être publié."}},"he":{"stringUnit":{"state":"needs_review","value":"שיא נקודות ממתין לפרסום."}},"nl":{"stringUnit":{"state":"needs_review","value":"Er wacht nog een topscore op publicatie."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"A melhor pontuação está aguardando publicação."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"A melhor pontuação está à espera de ser publicada."}},"ru":{"stringUnit":{"state":"needs_review","value":"Лучший результат ждёт публикации."}}}},
                    "Nothing is shared before you choose a public alias.": {"extractionState":"manual","comment":"iOS release integration; non-English fallback requires linguistic review.","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ይፋዊ ቅጽል ስም ከመምረጥዎ በፊት ምንም ነገር አይጋራም።"}},"ar":{"stringUnit":{"state":"needs_review","value":"لا تتم مشاركة أي شيء قبل أن تختار اسمًا مستعارًا يظهر للجميع."}},"de":{"stringUnit":{"state":"needs_review","value":"Nichts wird geteilt, bevor du einen öffentlichen Spitznamen wählst."}},"en":{"stringUnit":{"state":"translated","value":"Nothing is shared before you choose a public alias."}},"es":{"stringUnit":{"state":"needs_review","value":"No se comparte nada hasta que elijas un apodo público."}},"fr":{"stringUnit":{"state":"needs_review","value":"Rien n’est partagé tant que tu n’as pas choisi de pseudo public."}},"he":{"stringUnit":{"state":"needs_review","value":"שום דבר לא ישותף לפני שתבחרו כינוי ציבורי."}},"nl":{"stringUnit":{"state":"needs_review","value":"Er wordt niets gedeeld voordat je een openbare bijnaam kiest."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Nada é compartilhado antes de você escolher um apelido público."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Nada é partilhado antes de escolheres uma alcunha pública."}},"ru":{"stringUnit":{"state":"needs_review","value":"Пока ты не выберешь публичное прозвище, ничего не публикуется."}}}},
                    "Turns public leaderboard participation on or off": {"extractionState":"manual","comment":"iOS release integration; non-English fallback requires linguistic review.","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"በይፋዊው የውጤት ሰንጠረዥ ላይ ተሳትፎን ያበራል ወይም ያጠፋል"}},"ar":{"stringUnit":{"state":"needs_review","value":"يفعّل المشاركة في قائمة المتصدرين العامة أو يوقفها"}},"de":{"stringUnit":{"state":"needs_review","value":"Schaltet die Teilnahme an der öffentlichen Bestenliste ein oder aus"}},"en":{"stringUnit":{"state":"translated","value":"Turns public leaderboard participation on or off"}},"es":{"stringUnit":{"state":"needs_review","value":"Activa o desactiva la participación en la clasificación pública"}},"fr":{"stringUnit":{"state":"needs_review","value":"Active ou désactive la participation au classement public"}},"he":{"stringUnit":{"state":"needs_review","value":"מפעיל או מכבה את ההשתתפות בטבלת השיאים הציבורית"}},"nl":{"stringUnit":{"state":"needs_review","value":"Zet deelname aan de openbare ranglijst aan of uit"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Ativa ou desativa a participação no ranking público"}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Ativa ou desativa a participação na classificação pública"}},"ru":{"stringUnit":{"state":"needs_review","value":"Включает или выключает участие в публичной таблице лидеров"}}}},
                    "Deletes this participant’s public leaderboard records": {"extractionState":"manual","comment":"iOS release integration; non-English fallback requires linguistic review.","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"የዚህን ተሳታፊ ይፋዊ ሪከርዶች ይሰርዛል"}},"ar":{"stringUnit":{"state":"needs_review","value":"يحذف الأرقام القياسية لهذا المشارك من قائمة المتصدرين العامة"}},"de":{"stringUnit":{"state":"needs_review","value":"Löscht die Rekorde dieses Teilnehmers in der öffentlichen Bestenliste"}},"en":{"stringUnit":{"state":"translated","value":"Deletes this participant’s public leaderboard records"}},"es":{"stringUnit":{"state":"needs_review","value":"Elimina los récords de este participante en la clasificación pública"}},"fr":{"stringUnit":{"state":"needs_review","value":"Supprime les records publics de ce participant"}},"he":{"stringUnit":{"state":"needs_review","value":"מוחק את השיאים הציבוריים של המשתתף הזה"}},"nl":{"stringUnit":{"state":"needs_review","value":"Verwijdert de openbare records van deze deelnemer"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Exclui os recordes deste participante no ranking público"}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Apaga os recordes deste participante na classificação pública"}},"ru":{"stringUnit":{"state":"needs_review","value":"Удаляет публичные рекорды этого участника"}}}},
                    "This score is ready to publish when Online leaderboard is on and Firebase is available.": {"extractionState":"manual","comment":"iOS release integration; non-English fallback requires linguistic review.","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ይህ ውጤት «የመስመር ላይ የውጤት ሰንጠረዥ» ሲበራ እና Firebase ሲገኝ ይፋ ይሆናል።"}},"ar":{"stringUnit":{"state":"needs_review","value":"هذه النتيجة جاهزة للنشر عند تفعيل قائمة المتصدرين عبر الإنترنت وتوفّر Firebase."}},"de":{"stringUnit":{"state":"needs_review","value":"Diese Punktzahl kann veröffentlicht werden, sobald die Online-Bestenliste eingeschaltet und Firebase verfügbar ist."}},"en":{"stringUnit":{"state":"translated","value":"This score is ready to publish when Online leaderboard is on and Firebase is available."}},"es":{"stringUnit":{"state":"needs_review","value":"Esta puntuación se publicará cuando la opción Clasificación en línea esté activada y Firebase esté disponible."}},"fr":{"stringUnit":{"state":"needs_review","value":"Ce score sera publié quand le classement en ligne sera activé et que Firebase sera disponible."}},"he":{"stringUnit":{"state":"needs_review","value":"התוצאה הזאת תפורסם כשטבלת השיאים המקוונת תופעל ו־Firebase יהיה זמין."}},"nl":{"stringUnit":{"state":"needs_review","value":"Deze score wordt gepubliceerd zodra de online ranglijst aanstaat en Firebase beschikbaar is."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Esta pontuação será publicada quando o ranking online estiver ativado e o Firebase estiver disponível."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Esta pontuação será publicada quando a classificação online estiver ativada e o Firebase estiver disponível."}},"ru":{"stringUnit":{"state":"needs_review","value":"Этот результат будет опубликован, когда онлайн-таблица лидеров будет включена, а Firebase — доступен."}}}},
                    "Only an opaque participant identifier, generated alias or avatar, score or streak, product identifier, and timestamp are sent.": {"extractionState":"manual","comment":"iOS release integration; non-English fallback requires linguistic review.","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"የሚላኩት ማንነትን የማይገልጽ የተሳታፊ መለያ፣ በራስ-ሰር የተፈጠረ ቅጽል ስም ወይም አምሳያ፣ ውጤት ወይም ተከታታይ ስኬት፣ የምርት መለያ እና የጊዜ ማህተም ብቻ ናቸው።"}},"ar":{"stringUnit":{"state":"needs_review","value":"لا يُرسَل سوى معرّف مجهول للمشارك، والاسم المستعار أو الصورة الرمزية المُنشأة تلقائيًا، والنقاط أو سلسلة الإجابات الصحيحة، ومعرّف المنتج، والطابع الزمني."}},"de":{"stringUnit":{"state":"needs_review","value":"Übermittelt werden nur eine pseudonyme Teilnehmer-ID, ein automatisch erstellter Spitzname oder Avatar, die Punktzahl oder Serie, eine Produktkennung und ein Zeitstempel."}},"en":{"stringUnit":{"state":"translated","value":"Only an opaque participant identifier, generated alias or avatar, score or streak, product identifier, and timestamp are sent."}},"es":{"stringUnit":{"state":"needs_review","value":"Solo se envían un identificador anónimo del participante, el apodo o avatar generado, la puntuación o la racha, el identificador del producto y la fecha y la hora."}},"fr":{"stringUnit":{"state":"needs_review","value":"Seuls sont envoyés : un identifiant de participant non nominatif, le pseudo ou l’avatar généré automatiquement, le score ou la série, l’identifiant du produit et l’horodatage."}},"he":{"stringUnit":{"state":"needs_review","value":"נשלחים רק מזהה משתתף אנונימי, כינוי או דמות שנוצרו אוטומטית, ניקוד או רצף, מזהה מוצר וחותמת זמן."}},"nl":{"stringUnit":{"state":"needs_review","value":"Er worden alleen een anonieme deelnemerscode, een automatisch gemaakte bijnaam of avatar, een score of reeks, een productcode en een tijdstempel verstuurd."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"São enviados apenas um identificador anônimo do participante, o apelido ou avatar gerado, a pontuação ou sequência, o identificador do produto e a data e hora."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"São enviados apenas um identificador anónimo do participante, a alcunha ou o avatar gerados, a pontuação ou a sequência, o identificador do produto e a data e hora."}},"ru":{"stringUnit":{"state":"needs_review","value":"Передаются только обезличенный идентификатор участника, автоматически созданное прозвище или аватар, очки или серия, идентификатор продукта и отметка времени."}}}},
                    "Choose a fun public alias for the online leaderboard.": {"extractionState":"manual","comment":"iOS release integration; non-English fallback requires linguistic review.","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ለመስመር ላይ የውጤት ሰንጠረዡ አስደሳች ይፋዊ ቅጽል ስም ይምረጡ።"}},"ar":{"stringUnit":{"state":"needs_review","value":"اختر اسمًا مستعارًا ممتعًا يظهر في قائمة المتصدرين عبر الإنترنت."}},"de":{"stringUnit":{"state":"needs_review","value":"Wähle einen lustigen öffentlichen Spitznamen für die Online-Bestenliste."}},"en":{"stringUnit":{"state":"translated","value":"Choose a fun public alias for the online leaderboard."}},"es":{"stringUnit":{"state":"needs_review","value":"Elige un apodo público divertido para la clasificación en línea."}},"fr":{"stringUnit":{"state":"needs_review","value":"Choisis un pseudo public amusant pour le classement en ligne."}},"he":{"stringUnit":{"state":"needs_review","value":"בחרו כינוי ציבורי כיפי לטבלת השיאים המקוונת."}},"nl":{"stringUnit":{"state":"needs_review","value":"Kies een leuke openbare bijnaam voor de online ranglijst."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Escolha um apelido público divertido para o ranking online."}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Escolhe uma alcunha pública divertida para a classificação online."}},"ru":{"stringUnit":{"state":"needs_review","value":"Выбери забавное прозвище для онлайн-таблицы лидеров."}}}},
