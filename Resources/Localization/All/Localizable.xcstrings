                    "Step by step: one fact at a time, with pictures": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"ደረጃ በደረጃ፦ በአንድ ጊዜ አንድ ስሌት፣ ከምስሎች ጋር"}},"ar":{"stringUnit":{"state":"needs_review","value":"خطوة بخطوة: حقيقة واحدة في كل مرة، مع صور"}},"de":{"stringUnit":{"state":"needs_review","value":"Schritt für Schritt: eins nach dem anderen, mit Bildern"}},"en":{"stringUnit":{"state":"translated","value":"Step by step: one fact at a time, with pictures"}},"es":{"stringUnit":{"state":"needs_review","value":"Paso a paso: un dato cada vez, con imágenes"}},"fr":{"stringUnit":{"state":"needs_review","value":"Pas à pas : un fait à la fois, en images"}},"he":{"stringUnit":{"state":"needs_review","value":"צעד אחר צעד: עובדה אחת בכל פעם, עם תמונות"}},"nl":{"stringUnit":{"state":"needs_review","value":"Stap voor stap: één rekenfeit tegelijk, met afbeeldingen"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Passo a passo: um fato de cada vez, com imagens"}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Passo a passo: um facto de cada vez, com imagens"}},"ru":{"stringUnit":{"state":"needs_review","value":"Шаг за шагом: по одному примеру, с картинками"}}}},
