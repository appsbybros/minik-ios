                    "Opens locally stored streak records": {"extractionState":"manual","localizations":{"am":{"stringUnit":{"state":"needs_review","value":"በዚህ መሣሪያ ላይ የተቀመጡ የተከታታይ ስኬት ሪከርዶችን ይከፍታል"}},"ar":{"stringUnit":{"state":"needs_review","value":"يفتح الأرقام القياسية للسلاسل المحفوظة على الجهاز"}},"de":{"stringUnit":{"state":"needs_review","value":"Öffnet die auf diesem Gerät gespeicherten Serienrekorde"}},"en":{"stringUnit":{"state":"translated","value":"Opens locally stored streak records"}},"es":{"stringUnit":{"state":"needs_review","value":"Abre los récords de racha guardados en el dispositivo"}},"fr":{"stringUnit":{"state":"needs_review","value":"Ouvre les records de série enregistrés sur l’appareil"}},"he":{"stringUnit":{"state":"needs_review","value":"פותח את שיאי הרצף השמורים במכשיר"}},"nl":{"stringUnit":{"state":"needs_review","value":"Opent de reeksrecords die op dit apparaat zijn opgeslagen"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Abre os recordes de sequência salvos neste dispositivo"}},"pt-PT":{"stringUnit":{"state":"needs_review","value":"Abre os recordes de sequência guardados neste dispositivo"}},"ru":{"stringUnit":{"state":"needs_review","value":"Открывает рекорды серий, сохранённые на этом устройстве"}}}},
